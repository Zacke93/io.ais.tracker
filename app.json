{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "io.aisstream.bridge",
  "name": {
    "en": "AIS Bridge",
    "sv": "AIS Bridge"
  },
  "version": "5.3.0",
  "category": [
    "tools"
  ],
  "description": {
    "en": "Live bridge-opening alerts for the Trollhätte canal. Tracks vessels via AIS and tells you when Klaffbron or Stridsbergsbron is about to open — as a status text and Flow triggers.",
    "sv": "Broöppningskoll för Trollhätte kanal i realtid. Spårar fartyg via AIS och berättar när Klaffbron eller Stridsbergsbron är på väg att öppna — som statustext och Flow-triggers."
  },
  "icon": "/assets/icon.svg",
  "brandColor": "#000000",
  "images": {
    "small": "/assets/images/app_small.png",
    "large": "/assets/images/app_large.png",
    "xlarge": "/assets/images/app_xlarge.png"
  },
  "author": {
    "name": "Zakarias Mortensen",
    "email": "Zaka_9@hotmail.com"
  },
  "support": "mailto:Zaka_9@hotmail.com",
  "source": "https://github.com/Zacke93/io.ais.tracker",
  "sdk": 3,
  "compatibility": ">=6.0.0",
  "settings": [
    {
      "id": "ais_api_key",
      "type": "password",
      "title": {
        "en": "AISStream API key",
        "sv": "AISStream API-nyckel"
      },
      "hint": {
        "en": "Create a free key at https://aisstream.io (a long string of letters and digits).",
        "sv": "Skapa en gratis nyckel på https://aisstream.io (en lång sträng med bokstäver och siffror)."
      }
    },
    {
      "id": "aishub_username",
      "type": "text",
      "title": {
        "en": "AISHub username (optional)",
        "sv": "AISHub-användarnamn (valfritt)"
      },
      "hint": {
        "en": "Requires an AISHub membership with your own NMEA station: API access is granted only while your station reports at least 10 vessels per 7 days with at least 90% uptime. Poll one username from ONE device only (AISHub allows max 1 request/minute). AIS data: AISHub (aishub.net).",
        "sv": "Kräver AISHub-medlemskap med egen NMEA-station: API-access ges bara medan din station rapporterar minst 10 fartyg per 7 dygn med minst 90 % upptid. Polla ett användarnamn från EN enhet (AISHub tillåter max 1 anrop/minut). AIS-data: AISHub (aishub.net)."
      }
    }
  ],
