+}
+
+describe('avgångskontexten i ProgressiveETACalculator', () => {
+  let calc;
+
+  beforeEach(() => {
+    jest.useFakeTimers({ now: Date.parse('2026-06-22T11:30:00Z') });
+    calc = new ProgressiveETACalculator(logger, new BridgeRegistry());
