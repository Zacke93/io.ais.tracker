+   * högst DEPARTURE_CONTEXT_MAX_AGE_MS sedan avgången. En utgången kontext
+   * städas här.
+   * @param {Object} vessel - fartyget
+   * @param {number} sog - aktuell fart
+   * @returns {boolean} sant under igångsättningen
+   * @private
+   */
+  _inDepartureContext(vessel, sog) {
+    const departure = this._departures.get(vessel.mmsi);
+    if (!departure) return false;
