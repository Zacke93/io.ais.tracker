+  /**
+   * Familj E (F04): bokför ett NYTT fartsampel mot avgångskontexten. Anropas
+   * bara när sampelnyckeln är ny (samma villkor som pushen i fartbufferten).
+   * Avgång = första sampel med verklig fart (>= MOVEMENT_SOG_KNOTS) efter
+   * belagd stillhet: minst DEPARTURE_STILL_SAMPLES buffrade sampel, alla
+   * under MOORING_DETECTION.MOVEMENT_PROOF_SOG_KN. Då hör buffertens sampel
+   * till väntan, inte till genomfarten, och töms innan det nya läggs in.
+   * @param {string|number} mmsi - fartygets nyckel (samma som fartbufferten)
+   * @param {number[]} buffer - fartbufferten FÖRE pushen (muteras vid avgång)
+   * @param {number} sog - det nya sampelts fart
+   * @param {string} key - sampelnyckeln
+   * @private
+   */
+  _noteDepartureSample(mmsi, buffer, sog, key) {
+    const moving = Number.isFinite(sog) && sog >= MOVEMENT_SOG_KNOTS;
+    const departure = this._departures.get(mmsi);
+    if (!moving) {
+      // Båten stannade igen: kontexten är slut, nästa avgång prövas på nytt.
+      if (departure) this._departures.delete(mmsi);
+      return;
+    }
+    if (buffer.length >= DEPARTURE_STILL_SAMPLES
+        && buffer.every((s) => s < MOORING_DETECTION.MOVEMENT_PROOF_SOG_KN)) {
+      this.logger.debug(
+        `🚀 [ETA_DEPARTURE] ${mmsi}: första rörliga sampel (${sog.toFixed(1)}kn) efter stillhet `
+        + `[${buffer.map((s) => s.toFixed(1)).join(', ')}] — väntans sampel lämnar fartbufferten`,
+      );
+      buffer.length = 0;
+      this._departures.set(mmsi, {
+        atMs: Date.now(), samples: 1, lastKey: key, lastSog: sog,
+      });
+      return;
+    }
+    if (departure && departure.lastKey !== key) {
+      // Igångsättningen pågår bara så länge farten STIGER. En båt som slutat
+      // accelerera har nått sin fart (eller saktar in igen, t.ex. för att
+      // förtöja) — då är buffertens snitt rätt mått och golvet ska bort.
+      if (sog < departure.lastSog) {
+        this._departures.delete(mmsi);
+        return;
+      }
+      departure.samples += 1;
+      departure.lastKey = key;
+      departure.lastSog = sog;
+    }
+  }
+
+  /**
