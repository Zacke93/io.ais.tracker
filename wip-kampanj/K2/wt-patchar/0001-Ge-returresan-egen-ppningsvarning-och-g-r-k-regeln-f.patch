+
+  // Hela korpusen flyttas δ s (aisTimestamp, fixTs, receivedAt; typbevarande),
+  // som buggjägarens M-FAS-relation. Före rättningen gav δ −15, −11,52, +15
+  // och +20 s en extra Klaffbron-varning för VIRGO (265552100).
+  const openingKeys = (deltaS) => {
+    const deltaMs = Math.round(deltaS * 1000);
+    const rows = fs.readFileSync(source, 'utf8').split('\n').filter(Boolean).map((line) => {
+      const row = JSON.parse(line);
+      for (const field of ['aisTimestamp', 'fixTs', 'receivedAt']) {
+        if (typeof row[field] === 'number') row[field] += deltaMs;
+        else if (typeof row[field] === 'string' && row[field]) {
+          row[field] = new Date(Date.parse(row[field]) + deltaMs).toISOString();
+        }
+      }
+      return JSON.stringify(row);
+    });
+    const file = path.join(directory, `13h-${deltaS}.jsonl`);
+    fs.writeFileSync(file, `${rows.join('\n')}\n`);
+    const out = execFileSync(process.execPath, [path.join(replayDir, 'replayRunner.js'), file], {
+      cwd: path.join(__dirname, '..'),
+      encoding: 'utf8',
+      maxBuffer: 64 * 1024 * 1024,
+      env: { ...process.env, REPLAY_MONITORING: '0' },
+    });
+    const result = JSON.parse(out.match(/__REPLAY_JSON__(.*?)__END__/s)[1]);
+    expect(result.processErrors).toBe(0);
+    return result.openingWarnings
+      .map((w) => `${w.bridge}|${w.direction}|${w.leadMmsi}|${(w.mmsis || []).join(',')}`)
+      .sort();
+  };
+
+  test('δ ∈ {−15, −11,52, +15, +20} s ger samma öppningsnycklar som basen', () => {
+    const base = openingKeys(0);
+    expect(base.filter((k) => k.startsWith('Klaffbron|northbound|265552100'))).toHaveLength(0);
+    for (const deltaS of [-15, -11.52, 15, 20]) {
+      expect({ deltaS, keys: openingKeys(deltaS) }).toEqual({ deltaS, keys: base });
+    }
+  }, 120000);
+});
