+  const replayDir = path.join(__dirname, 'replay-validation');
+  const source = path.join(replayDir, 'corpora-data/ais-replay-20260710-015254.jsonl');
+  let directory;
+  beforeAll(() => {
+    directory = fs.mkdtempSync(path.join(os.tmpdir(), 'k2-fas-13h-'));
+  });
