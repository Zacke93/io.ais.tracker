+    const [a, b] = play([[0, 556, 2.4], [66, 459, 2.1, { fixAgeS: 9 }]], 66 + 300, [withRule, without]);
+    const arm = withRule.service._arms.get(`${MMSI}::${TARGET}`);
+    if (arm) {
+      const expectedHold = arm.anchorMs + Math.min(300000, (arm.distanceM / (2.1 * KN)) * 1000 - LEAD_MS);
