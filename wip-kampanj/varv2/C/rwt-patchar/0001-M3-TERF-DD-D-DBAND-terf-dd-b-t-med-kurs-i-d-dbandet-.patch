+  åter: {
+    t: Date.parse('2026-09-05T13:44:47.134Z'), lat: 58.3074216012013, lon: 12.313119081766153, sog: 6.4, cog: 229.6,
+  },
+  mps: -3.408,
+};
+const HAVSORN = { // värld 1913, norrut mot Klaffbron (tredje återfödelsen)
+  mmsi: '265629897',
