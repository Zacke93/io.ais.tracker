+    texter: r.bridgeTextTransitions.map((t) => [t.iso, t.text]),
+    notiser: r.notifications.map((n) => [n.t, n.bridge, n.direction, n.eta]),
+    passager: r.targetPassages.map((p) => [p.t, p.bridge]),
+  });
+
