+  /**
+   * Varv 2 (triage A, skiss): MÅLBRO I SAMMA TICK SOM EN BEKRÄFTAD VÄNDNING.
+   * Två vägar bekräftade vändningen men lämnade måltilldelningen åt nästa fix:
+   * RE_CROSS_EVIDENCED inne i målbrogrenen (else-if-kedjan i updateVessel
+   * hoppar då över ACCELERATED-grenen) och app-lagrets NEW_JOURNEY (körs
+   * efter updateVessel). Med gles AIS kom målbron, och därmed armen och
+   * öppningsvarningen, först vid nästa fix (buggjägarens värld 936, 1208,
+   * 1274, 1316, 1317 och 1918). U18 är oförändrad: anropas bara efter en
+   * bekräftad vändning. Samma grindar som ACCELERATED-grenen, med det gamla
+   * målet ogiltigt (som fixDReversalConfirmed).
+   * @param {Object} vessel
+   * @param {Object|null} oldVessel
+   * @param {string} direction - 'north' eller 'south' (den bekräftade)
+   * @param {string} reason - loggetikett
+   * @returns {string|null} den tilldelade målbron
+   */
+  assignTargetAfterReversal(vessel, oldVessel, direction, reason) {
+    if (!vessel || vessel.targetBridge || vessel._moored) return null;
+    if (direction !== 'north' && direction !== 'south') return null;
+    if (!this._shouldAssignTargetBridge(vessel, oldVessel, true)) return null;
+    const target = this._calculateTargetBridge(vessel, direction);
+    const bridge = target ? this.bridgeRegistry.getBridgeByName(target) : null;
+    if (!bridge || !Number.isFinite(bridge.lat) || !Number.isFinite(bridge.lon)) return null;
+    const distance = geometry.calculateDistance(vessel.lat, vessel.lon, bridge.lat, bridge.lon);
+    // Inom appens under-bro-band avgör nästa fix, som förut: där är brus och
+    // linjens läge av samma storlek (U14-vakten med ±30 m brus i 1 kn gav annars
+    // en fantompassage och en extra varning vid Klaffbron).
+    if (!Number.isFinite(distance) || distance <= constants.UNDER_BRIDGE_CLEAR_DISTANCE) return null;
+    this.logger.log(
+      `🔄 [TARGET_CHANGE] ${vessel.mmsi}: "none" → "${target}" | Reason: REVERSAL_SAME_TICK (${reason}) `
+      + `| Distance to target: ${Number.isFinite(distance) ? distance.toFixed(0) : '?'}m | Speed: ${vessel.sog}kn`,
+    );
+    vessel.targetBridge = target;
+    this._lockRouteDirection(vessel, direction);
+    this._extendJourneyOrigin(vessel, direction, `target-assign-reversal-${reason}`);
+    return target;
+  }
