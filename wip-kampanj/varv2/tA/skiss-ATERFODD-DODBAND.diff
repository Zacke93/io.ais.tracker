+  /**
+   * Varv 2 (triage A, skiss C): K1-riktningen för en återfödd båt, eller null.
+   * Samma mätning och ribba som app-lagrets _freshNorthProgressMps (paret ska
+   * höra till detta meddelande), men tecknet avgör riktningen. Kräver fart
+   * ≥ 2 kn (FIX_D_MIN_SOG) och att kursen inte ligger i motsatt riktnings band.
+   * @private
+   */
+  _rebirthDirectionEvidence(vessel) {
+    const progress = vessel?._lastNorthProgress;
+    if (!progress || !Number.isFinite(progress.mps)) return null;
+    const ts = Math.max(
+      Number.isFinite(vessel.lastPositionUpdate) ? vessel.lastPositionUpdate : 0,
+      Number.isFinite(vessel.timestamp) ? vessel.timestamp : 0,
+    );
+    // Nettofarten i farledens längdriktning ska motsvara transitfart (Fix D:s
+    // 2 kn), inte bara K1-ribban: en kajliggare vid Kanalinfarten som återföds
+    // var 3:e minut (NORDIC SOLA, 0,43 m/s i 20260713-41h) ska inte få målbro här.
+    const transitMps = 2.0 * 0.514444;
+    if (progress.ts !== ts || Math.abs(progress.mps) < Math.max(NORTH_PROGRESS_MIN_MPS, transitMps)) return null;
+    if (!Number.isFinite(vessel.sog) || vessel.sog < 2.0) return null;
+    const dir = progress.mps > 0 ? 'north' : 'south';
+    if (Number.isFinite(vessel.cog)
+        && (dir === 'north' ? isSouthCogStrict(vessel.cog) : isNorthCog(vessel.cog))) return null;
+    return dir;
+  }
