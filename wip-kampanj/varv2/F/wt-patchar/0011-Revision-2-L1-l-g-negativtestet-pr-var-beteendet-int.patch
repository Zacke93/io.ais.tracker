Omgranskningen av familj F: testet "en båt som klassningen aldrig höll"
fällde revision 0 bara på det nya fältet heldAsQueue; beteendet var
detsamma. Testet prövar nu att minnet hör till det stopp som klassningen
höll: köaren hålls vid stopp A, efter en omstart ligger hon 60 m bort vid
kapselns norra spets där klassningen inte håller henne, och stopp B
bekräftas med 30 s-regeln så att avgången är en ny ankomst. Ett minne som
följde med från A, eller gällde varje stopp vid Kajen, fäller testet.
Testet klarar både 3887254 och HEAD.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01DNCqwt4q1MF8G4Aw5jG5pc
---
 tests/opening-queue-quay-stop.test.js | 29 +++++++++++++++++++--------
 1 file changed, 21 insertions(+), 8 deletions(-)

diff --git a/tests/opening-queue-quay-stop.test.js b/tests/opening-queue-quay-stop.test.js
index 7f16723..30f348e 100644
--- a/tests/opening-queue-quay-stop.test.js
+++ b/tests/opening-queue-quay-stop.test.js
@@ -364,14 +364,27 @@ describe('Öppningslagret: kort köstopp vid Kajen är samma ankomst', () => {
     departAndExpectSameArrival(false);
   });
 
-  test('L1: en båt som klassningen aldrig höll som köare får inget minne', () => {
-    // Ny för appen redan vid stoppet (t.ex. AIS påslagen vid kajen): 30 s-
-    // regeln gäller som förut, och avgången är en ny ankomst.
-    const at = mid(KAJEN);
-    app._observeOpeningArrivals(fix(at, 0.1, LOST));
-    stillAt(at, 60000, LOST);
-    expect(app._persistentOpeningWarnings.get(KEY).quayStop)
-      .toMatchObject({ confirmed: true, heldAsQueue: false });
+  // Negativtest (klarar både 3887254 och L1; omgranskningen av familj F,
+  // revision 2): minnet hör till det stopp som klassningen höll. Köaren hålls
+  // vid stopp A; efter en omstart ligger hon 60 m bort vid kapselns norra
+  // spets (stopp B), där klassningen inte håller henne. Stopp B bekräftas med
+  // 30 s-regeln, och avgången är en ny ankomst. Ett minne som följde med från
+  // A, eller som gällde varje stopp vid Kajen, hade gjort avgången till samma
+  // ankomst.
+  test('L1: ett stopp där klassningen aldrig höll henne får inget minne, inte heller från ett tidigare stopp', async () => {
+    const a = mid(KAJEN);
+    const b = {
+      lat: KAJEN.end.lat + (KAJEN.end.lat - KAJEN.start.lat) * 0.1,
+      lon: KAJEN.end.lon + (KAJEN.end.lon - KAJEN.start.lon) * 0.1,
+    };
+    expect(geometry.calculateDistance(a.lat, a.lon, b.lat, b.lon)).toBeGreaterThanOrEqual(50);
+    app._observeOpeningArrivals(fix(a, 0.1));
+    stillAt(a, 10 * 60 * 1000);
+    await restart();
+    app._observeOpeningArrivals(fix(b, 0.1, LOST));
+    expect(app._persistentOpeningWarnings.get(KEY).quayStop.confirmed).toBe(false);
+    stillAt(b, 60000, LOST);
+    expect(app._persistentOpeningWarnings.get(KEY).quayStop.confirmed).toBe(true);
     departAndExpectSameArrival(false);
   });
 
