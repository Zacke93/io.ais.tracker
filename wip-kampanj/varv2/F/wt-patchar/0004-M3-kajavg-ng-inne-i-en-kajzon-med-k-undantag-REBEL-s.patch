diff --git a/app.js b/app.js
index cf5550a..9713589 100755
--- a/app.js
+++ b/app.js
@@ -1542,7 +1542,23 @@ class AISBridgeApp extends Homey.App {
         ? 0 : queueGraceMs;
       const stop = entry.quayStop;
       const movedFromStop = stop && geometry.calculateDistance(stop.lat, stop.lon, vessel.lat, vessel.lon);
-      if (stop?.confirmed && !atQuay && vessel._moored !== true
+      // Avgången kräver normalt en fix utanför kajzonerna. Inne i en kajzon med
+      // köundantag ("Kajen norr om Klaffbron", mitt i väntzonen mellan
+      // Gästhamnen och bron) räcker att båten flyttat sig minst 50 m från
+      // stoppet MOT kortets bro — annars kom avgångsbeviset först vid nästa fix,
+      // ofta efter passagen. S/V REBEL (20260806-42h, 2026-08-07) lämnade sitt
+      // bekräftade övernattningsstopp i Gästhamnen; första rörelsefixen låg i
+      // Kajen 249 m från Klaffbron, och fältappens kort 08:44:41 (Klaffbron#19)
+      // spärrades i replayn av gårdagens ankomst (helgranskning-2026-11-03:
+      // "räkna rörelse ≥ 50 m från ett bekräftat stopp som avgång även i en
+      // annan kajzon"). Samma grind gjorde varningen sen för varje båt som
+      // U23 släpper vid Kajen (navstatus, 2 h, omstart, AIS-glapp): 43 → 73 s
+      // före korsningen i de syntetiska proven. Ett bekräftat stopp krävs som
+      // förut, så en köare som klassningen håller berörs inte.
+      const stopDistance = stop && geometry.calculateDistance(stop.lat, stop.lon, bridge.lat, bridge.lon);
+      const leftQuay = !atQuay || (Number(quayZone?.queueGraceMs) > 0
+        && Number.isFinite(stopDistance) && stopDistance - distance >= 50);
+      if (stop?.confirmed && leftQuay && vessel._moored !== true
           && movedFromStop >= 50 && Number.isFinite(vessel.sog) && vessel.sog >= 0.5) {
         this._persistentOpeningWarnings.delete(key);
         this.bridgeOpeningService?.restartArrival?.(vessel.mmsi, bridgeName);
diff --git a/docs/helgranskning-2026-11-03.md b/docs/helgranskning-2026-11-03.md
index ddf59f6..3a402d9 100644
--- a/docs/helgranskning-2026-11-03.md
+++ b/docs/helgranskning-2026-11-03.md
@@ -251,6 +251,11 @@ beslut eller en senare runda.
     2026-08-07; passagen kom 08:46:26.
   - Rättning: räkna rörelse ≥ 50 m från ett bekräftat stopp som avgång även i
     en annan kajzon. Det ändrar låst facit med ett kort till.
+  - **Rättat 2026-11-09** (granskningen av familj F, M3): avgången godtas inne
+    i en kajzon med köundantag när båten flyttat minst 50 m från stoppet mot
+    bron (app.js `_observeOpeningArrivals`). REBEL:s kort kommer 08:44:41 vid
+    249 m, 105 s före korsningen; 20260806-42h omlåst (Klaffbron:southbound
+    18 → 19), se noten i corpora.js.
 - **AKIRA, glapp i Gästhamnen.** Ett AIS-glapp nollställer fortfarande ett
   obekräftat stopp i Gästhamnen. En övernattning med AIS avstängd ger därför
   inget morgonkort, men bara i kedjade körningar med persisterat minne.
diff --git a/tests/opening-queue-quay-stop.test.js b/tests/opening-queue-quay-stop.test.js
index 8bff63d..1ffceb0 100644
--- a/tests/opening-queue-quay-stop.test.js
+++ b/tests/opening-queue-quay-stop.test.js
@@ -165,6 +165,60 @@ describe('Öppningslagret: kort köstopp vid Kajen är samma ankomst', () => {
     expect(app.bridgeOpeningService.restartArrival).toHaveBeenCalledWith(MMSI, 'Klaffbron');
   });
 
+  // M3 (granskningen av familj F, 2026-11-09; helgranskning-2026-11-03, S/V
+  // REBEL i 20260806-42h): avgången från ett bekräftat stopp godtas inne i
+  // en kajzon med köundantag när båten flyttat minst 50 m från stoppet MOT
+  // bron. REBEL låg över natten i Gästhamnen; hennes första rörelsefix låg i
+  // Kajen 249 m från Klaffbron, och fältappens kort spärrades av gårdagens
+  // ankomst.
+  test('M3: bekräftat stopp i Gästhamnen, första rörelsefixen i Kajen mot bron ⇒ ny ankomst', () => {
+    const gasthamnen = mid(GASTHAMNEN);
+    app._observeOpeningArrivals(fix(gasthamnen, 0.1));
+    jest.setSystemTime(Date.now() + 30000);
+    app._observeOpeningArrivals(fix(gasthamnen, 0.1));
+    expect(app._persistentOpeningWarnings.get(KEY).quayStop.confirmed).toBe(true);
+    jest.setSystemTime(Date.now() + 8 * 60 * 60 * 1000);
+    app._observeOpeningArrivals(fix(mid(KAJEN), 3.0));
+    expect(app._persistentOpeningWarnings.has(KEY)).toBe(false);
+    expect(app.bridgeOpeningService.restartArrival).toHaveBeenCalledWith(MMSI, 'Klaffbron');
+  });
+
+  test('M3: rörelse inne i Kajen BORT från bron är ingen avgång', () => {
+    // Bekräftat stopp vid Kajens södra ände (förtöjd enligt klassningen),
+    // sedan en rörelsefix vid kapselns norra ände: över 50 m från stoppet
+    // men längre från Klaffbron, alltså ingen avgång mot bron.
+    const NAV5 = {
+      ...QUEUER, navStatus: 5, _moored: true, targetBridge: null,
+    };
+    const sydande = { lat: KAJEN.start.lat, lon: KAJEN.start.lon };
+    const nordande = { lat: KAJEN.end.lat, lon: KAJEN.end.lon };
+    app._observeOpeningArrivals(fix(sydande, 0.1, NAV5));
+    jest.setSystemTime(Date.now() + 30000);
+    app._observeOpeningArrivals(fix(sydande, 0.1, NAV5));
+    expect(app._persistentOpeningWarnings.get(KEY).quayStop.confirmed).toBe(true);
+    jest.setSystemTime(Date.now() + 60000);
+    app._observeOpeningArrivals(fix(nordande, 2.0, { ...QUEUER, _moored: false }));
+    expect(app._persistentOpeningWarnings.has(KEY)).toBe(true);
+    expect(app.bridgeOpeningService.restartArrival).not.toHaveBeenCalled();
+  });
+
+  test('M3: köaren som klassningen håller lägger ut genom Kajen ⇒ fortfarande samma ankomst', () => {
+    // Stoppet bekräftas aldrig medan U23 håller henne, så avgången inne i
+    // kapseln mot bron ger inget nytt kort.
+    const at = mid(KAJEN);
+    app._observeOpeningArrivals(fix(at, 0.1));
+    for (let elapsed = 30000; elapsed <= 25 * 60 * 1000; elapsed += 30000) {
+      jest.setSystemTime(Date.now() + 30000);
+      app._observeOpeningArrivals(fix(at, 0.1));
+    }
+    // Kapselns södra spets, 25 m bortom linjens ände: 167 m från Klaffbron,
+    // 73 m närmare bron än stoppet och fortfarande i kapseln.
+    jest.setSystemTime(Date.now() + 60000);
+    app._observeOpeningArrivals(fix({ lat: 58.285500, lon: 12.284923 }, 3.0));
+    expect(app._persistentOpeningWarnings.has(KEY)).toBe(true);
+    expect(app.bridgeOpeningService.restartArrival).not.toHaveBeenCalled();
+  });
+
   // Köskyddet gäller bara när bron ligger inom DISARM_MOORED_MIN_DISTANCE_M
   // (600 m), som i förtöjningsklassningen. Kajen ligger 980 m från
   // Stridsbergsbron: där är ett stopp vid kajen ett besök, inte brokö.
