+  test('L1: omstart mitt i kön vid Kajen ⇒ samma ankomst, inget nytt kort vid avgången', async () => {
+    const at = mid(KAJEN);
+    app._observeOpeningArrivals(fix(at, 0.1));
+    stillAt(at, 30 * 60 * 1000);
