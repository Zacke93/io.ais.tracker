+  // Omstart med samma inställningslager: ny app, samma lagrade ankomster.
+  async function restart() {
+    const { homey } = app;
+    await app.onUninit();
+    app = new App();
+    app.log = jest.fn();
+    app.error = jest.fn();
+    app.debug = jest.fn();
