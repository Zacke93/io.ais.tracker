diff --git a/tests/bridge-text-variant1.test.js b/tests/bridge-text-variant1.test.js
index c4b9ba9..4ede372 100644
--- a/tests/bridge-text-variant1.test.js
+++ b/tests/bridge-text-variant1.test.js
@@ -447,3 +447,74 @@ describe('BridgeTextService — Invariants', () => {
