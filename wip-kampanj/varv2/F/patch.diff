+      _isImminentAtTargetBridge: false, etaMinutes: null, timestamp: old, lastPositionUpdate: old,
+    });
+    expect(makeService().generateBridgeText([kaj])).toBe('En båt på väg mot Klaffbron, ETA okänd');
+  });
