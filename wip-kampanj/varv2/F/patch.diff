+      .toBe('En båt på väg mot Klaffbron, beräknad broöppning om 4 minuter');
+    expect(makeService().generateBridgeText([farled])).toBe(STRAX);
+  });
+
+  test('köaren vid Kajen med positionen äldre än 10 min ⇒ "ETA okänd"', () => {
