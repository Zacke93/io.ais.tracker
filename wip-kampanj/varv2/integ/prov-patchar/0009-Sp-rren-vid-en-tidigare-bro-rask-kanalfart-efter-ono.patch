diff --git a/tests/opening-earlier-bridge-silent-hold.test.js b/tests/opening-earlier-bridge-silent-hold.test.js
new file mode 100644
index 0000000..769db1e
--- /dev/null
+++ b/tests/opening-earlier-bridge-silent-hold.test.js
@@ -0,0 +1,198 @@
+'use strict';
+
+/**
+ * Spärren vid en tidigare bro i tystnad (familj D, varv 2, 2026-11-09).
+ *
+ * Buggjägarens värld 263 (F02, T2 LEDTID): BRISEN 265891927 hördes var
+ * 65–69:e sekund i 2,1–2,4 kn efter Klaffbron. Järnvägsbron räknas då som
+ * tidigare bro (_earlierBridgeAhead), och spärren håller henne till restiden
+ * i nuvarande fart minus WARNING_LEAD_MS. Sista fixet kom 459 m före
+ * Stridsbergsbron i 2,1 kn. Därefter var hon tyst i 272 s, accelererade efter
+ * Järnvägsbron och korsade i 4,2 kn. Varningen gick vid spärrens slut,
+ * 44 s före korsningen.
+ *
+ * Rättningen (_silentHoldLimitMs): har appen inte hört henne på dubbla hennes
+ * längsta mottagningsintervall räknas restiden på minst rask kanalfart, 4 kn.
+ * En båt som hörs som vanligt, en bekräftad kö, en båt i 4 kn eller fortare
+ * och en arm utan kadens berörs inte. De fallen jämförs mot samma tjänst med
+ * golvet avstängt (EARLIER_BRIDGE_SILENT_FLOOR_KN 0, alltså c14938f).
+ */
+
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+const { execFileSync } = require('child_process');
+const Service = require('../lib/services/BridgeOpeningService');
+const { BRIDGES, BRIDGE_OPENING } = require('../lib/constants');
+const { calculateDistance } = require('../lib/utils/geometry');
+
+const START = Date.parse('2026-08-09T14:55:00Z');
+const MMSI = '265891927';
+const TARGET = 'Stridsbergsbron';
+const KN = 0.514444;
+const KLAFF = BRIDGES.klaffbron;
+const STRID = BRIDGES.stridsbergsbron;
+const SPAN = calculateDistance(KLAFF.lat, KLAFF.lon, STRID.lat, STRID.lon);
+const LEAD_MS = BRIDGE_OPENING.WARNING_LEAD_MS;
+
+// En punkt d meter före Stridsbergsbron på linjen Klaffbron–Stridsbergsbron.
+const along = (d) => ({
+  lat: STRID.lat + (KLAFF.lat - STRID.lat) * (d / SPAN),
+  lon: STRID.lon + (KLAFF.lon - STRID.lon) * (d / SPAN),
+});
+
+describe('Spärren vid en tidigare bro: tystnad längre än kadensen (värld 263)', () => {
+  const services = [];
+  const make = (config) => {
+    const warnings = [];
+    const service = new Service({ onWarning: (w) => warnings.push(w), targetBridges: [TARGET], config });
+    services.push(service);
+    return { service, warnings };
+  };
+  // Båten norrut efter Klaffbron. fixAgeS ger AISHub-fixets ålder vid mottagningen.
+  const boat = (d, sog, { fixAgeS = 0, ...extra } = {}) => ({
+    mmsi: MMSI,
+    name: 'BRISEN',
+    ...along(d),
+    sog,
+    cog: 34,
+    targetBridge: TARGET,
+    _routeDirection: 'north',
+    _hasMovementProof: true,
+    timestamp: Date.now(),
+    lastPositionUpdate: Date.now(),
+    fixTs: Date.now() - fixAgeS * 1000,
+    fixFeed: 'aishub',
+    etaMinutes: null,
+    status: 'en-route',
+    passedBridges: ['Klaffbron'],
+    ...extra,
+  });
+  // Spela upp fixen [s efter START, avstånd, fart, extra] i alla tjänster.
+  const play = (fixes, runs) => {
+    for (const [s, d, sog, extra] of fixes) {
+      jest.setSystemTime(START + s * 1000);
+      for (const { service } of runs) service.observeVessel(boat(d, sog, extra));
+    }
+  };
+  // Ticka sekund för sekund till och med `untilS`; returnera varningarna.
+  const tickUntil = (untilS, runs) => {
+    const from = Math.floor((Date.now() - START) / 1000);
+    for (let s = from + 1; s <= untilS; s++) {
+      jest.setSystemTime(START + s * 1000);
+      for (const { service } of runs) service.tick();
+    }
+    return runs.map(({ warnings }) => warnings);
+  };
+  // Inflygningen ur värld 263: var 65–69:e sekund, 2,4 kn, sista fixet 459 m i 2,1 kn.
+  const APPROACH = [
+    [0, 1115, 2.5], [69, 941, 2.4], [134, 881, 2.5], [199, 832, 2.6],
+    [268, 699, 2.4], [334, 670, 2.4], [400, 556, 2.4], [466, 459, 2.1, { fixAgeS: 9 }],
+  ];
+  const LAST_S = 466;
+  const LONGEST_S = 69;
+
+  beforeEach(() => {
+    jest.useFakeTimers({ now: START });
+  });
+  afterEach(() => {
+    while (services.length) services.pop().destroy();
+    jest.useRealTimers();
+  });
+
+  test('en tystnad på mer än två kadenser släpper spärren på 4 kn, inte på kryparfarten', () => {
+    const run = make();
+    play(APPROACH, [run]);
+    const arm = run.service._arms.get(`${MMSI}::${TARGET}`);
+    expect(arm.earlierBridge).toBe('Järnvägsbron');
+    expect(run.warnings).toHaveLength(0);
+
+    const [warnings] = tickUntil(LAST_S + 300, [run]);
+    expect(warnings).toHaveLength(1);
+    const atS = (warnings[0].t - START) / 1000;
+    // Spärren släpper vid tystnadsgränsen: två gånger hennes längsta intervall.
+    expect(atS).toBe(LAST_S + 2 * LONGEST_S);
+    // Med 4 kn efter sista fixet är hon framme 459 m / 4 kn efter fixet; varningen
+    // ska ligga minst 60 s (C-IV:s golv) före. c14938f varnade 245 s efter
+    // fixet, efter ankomsten i 4 kn.
+    const fixS = LAST_S - 9;
