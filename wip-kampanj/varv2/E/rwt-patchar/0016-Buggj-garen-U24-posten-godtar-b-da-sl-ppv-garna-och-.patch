+    Object.assign(v, { t });
+    v.verdict = {
+      kind: 'bakkant',
+      reason: 'egen deadline ‹tid› förföll före händelsens första passage; prognos ‹tid› och fysik ‹tid› ligger efter fönstrets slut ‹tid›',
