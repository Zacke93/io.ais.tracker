+function instrumentCoverageVerdicts(ops, sink) {
+  if (!ops || typeof ops._coverageVerdict !== 'function' || ops._gtVerdictInstrumented) return;
+  ops._gtVerdictInstrumented = true;
+  const origVerdict = ops._coverageVerdict.bind(ops);
