+    expect(geometry.decisiveBridgeSide(north(5), KLAFF)).toBe(0);
+    expect(geometry.decisiveBridgeSide({ lat: null, lon: KLAFF.lon }, KLAFF)).toBe(0);
+    expect(geometry.decisiveBridgeSide(north(200), null)).toBe(0);
+  });
