+  /**
+   * F12/F16 (rättningskampanjen 2026-11-04): släpp kandidaten för EN bro när
+   * en annan väg redan har bokfört brons passage.
+   *
+   * Kandidaten är en passage som grinden håller inne tills GPS:en är stabil.
+   * Bokför glappvägen (GAP_TARGET_INFERRED), normalvägen eller RC9-inferensen
+   * samma bro under tiden är kandidaten förbrukad. Annars bekräftas den senare
+   * (TTL 20 min) och bokför bron en gång till. Det var JOLLY i värld 254:
+   * glappvägen bokförde Stridsbergsbron 16:03:34, kandidaten från samma tick
+   * bekräftades 795 s senare och blev en mellanbropassage medan båten låg
+   * stilla i kön (INV-13 och T10 FANTOMPASSAGE).
+   *
+   * Släppet gäller bara den bokförda bron. Andra broars kandidater ligger kvar,
+   * eftersom de kan vara äkta passager som ännu inte bokförts (218023240 i
+   * 20260601-41h bekräftar Järnvägsbron i samma tick som Stridsbergsbrons
+   * glappinferens). Det är den kvarvarande halvan av B6 i
+   * reliability-review-2026-06-09.md; borttagningshalvan är clearVessel.
+   * @param {string} vesselId - Vessel MMSI
+   * @param {string} bridgeName - Bron vars passage nyss bokförts
+   * @returns {boolean} true om en kandidat släpptes
+   */
+  releaseCandidate(vesselId, bridgeName) {
+    const candidates = this._candidatePassages.get(vesselId);
+    if (!candidates || !bridgeName) return false;
+    const remaining = candidates.filter((c) => c.bridgeName !== bridgeName);
+    if (remaining.length === candidates.length) return false;
+    if (remaining.length > 0) {
+      this._candidatePassages.set(vesselId, remaining);
+    } else {
+      this._candidatePassages.delete(vesselId);
+    }
+    this.logger.debug(
+      `🧹 [GPS_GATE] ${vesselId}: Candidate for ${bridgeName} released — passage already booked by another path`,
+    );
+    return true;
+  }
