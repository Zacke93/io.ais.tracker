+   * som zonbesöket hade fått om det registrerats vid inträdesfixen. Beslutet
+   * vid utgången är oförändrat: METHOD 1 kräver fortfarande nettosidbyte mellan
+   * inträdesankaret och utgångsfixen, så en båt som vänder i zonen får ingen
+   * passage.
+   * @param {Object} vessel - fartygsobjektet (skrivs av beviset)
+   * @param {string} bridgeName - bron vars zon båten ligger i
+   * @param {number} distanceM - avståndet till bron
+   * @param {Object|null} prevFix - föregående rena observation
+   * @param {boolean} jumpTick - passet bär GPS-hopp/osäker position
+   * @private
+   */
+  _noteDeferredZoneEntryCross(vessel, bridgeName, distanceM, prevFix, jumpTick) {
+    if (!bridgeName || bridgeName === 'Stallbackabron') return;
+    if (!Number.isFinite(distanceM) || distanceM > UNDER_BRIDGE_SET_DISTANCE) return;
+    if (Array.isArray(vessel.passedBridges) && vessel.passedBridges.includes(bridgeName)) return;
+    if (vessel._underBridgeTimeoutBlockedBridge === bridgeName) return;
+    // Ett tidigare uppskjutande pass kan redan ha bevisat inträdet, och ett
+    // ordinarie pass emellan kan ha nollat beviset. Posten ligger kvar tills
+    // det ordinarie zonbesöket startar.
+    if (!jumpTick && vessel._underBridgeCrossedBridge !== bridgeName) {
+      this._restoreDeferredZoneEntryProof(vessel, bridgeName, false);
+    }
+    const provenBefore = vessel._underBridgeCrossedBridge === bridgeName;
+    this._noteUnderBridgeLineCross(vessel, bridgeName, prevFix, jumpTick);
+    if (!provenBefore && vessel._underBridgeCrossedBridge === bridgeName
+        && Number.isFinite(vessel._underBridgeEntryLat)
+        && Number.isFinite(vessel._underBridgeEntryLon)) {
+      vessel._underBridgeDeferredProof = {
+        bridge: bridgeName,
+        lat: vessel._underBridgeEntryLat,
+        lon: vessel._underBridgeEntryLon,
+        at: Date.now(),
+      };
+    }
+  }
+
+  /**
+   * Återställ ett sparat inträdesbevis för bridgeName (se
+   * _noteDeferredZoneEntryCross). Med consume=true startar ett ordinarie
+   * zonbesök: posten förbrukas då alltid, även när den gäller en annan bro.
+   * Giltigheten (tid, zon, GPS-hopp, bokförd bro) prövas i
+   * _expireDeferredZoneEntryProof överst i varje analys.
+   * @returns {boolean} true om beviset återställdes
+   * @private
+   */
+  _restoreDeferredZoneEntryProof(vessel, bridgeName, consume) {
+    const rec = vessel._underBridgeDeferredProof;
+    if (!rec) return false;
+    if (consume) vessel._underBridgeDeferredProof = null;
+    if (!bridgeName || rec.bridge !== bridgeName
+        || !Number.isFinite(rec.lat) || !Number.isFinite(rec.lon)) return false;
+    vessel._underBridgeCrossedBridge = bridgeName;
+    vessel._underBridgePendingCross = null;
+    vessel._underBridgeEntryLat = rec.lat;
+    vessel._underBridgeEntryLon = rec.lon;
+    this.logger.debug(
+      `🧵 [UNDER_BRIDGE_CROSS_PROOF_RESTORED] ${vessel.mmsi}: ${bridgeName} — inträdesbeviset från `
+      + `${new Date(rec.at).toISOString()} återställt `
+      + `(${consume ? 'zonbesöket startar' : 'uppskjutet pass'}), inträdesankaret på närsidan`,
+    );
+    return true;
+  }
+
+  /**
+   * Släpp ett sparat inträdesbevis som inte längre hör till samma zonbesök.
+   * Körs överst i varje analys, före FIX U och _isUnderBridge.
+   * @private
+   */
+  _expireDeferredZoneEntryProof(vessel, positionAnalysis) {
+    const rec = vessel._underBridgeDeferredProof;
+    if (!rec) return;
+    const ageMs = Date.now() - rec.at;
+    let reason = null;
+    if (this._isUnderBridgeJumpTick(vessel, positionAnalysis)) {
+      reason = 'GPS-hopp eller osäker position';
+    } else if ((Array.isArray(vessel.passedBridges) && vessel.passedBridges.includes(rec.bridge))
+        // En passage registrerad efter posten räcker, även om en vändning
+        // (N1-resetten) redan har lyft bron ur passedBridges.
+        || (vessel.lastPassedBridge === rec.bridge && Number.isFinite(vessel.lastPassedBridgeTime)
+          && vessel.lastPassedBridgeTime >= rec.at)) {
+      reason = 'bron är bokförd';
+    } else if (vessel._underBridgeCrossedBridge && vessel._underBridgeCrossedBridge !== rec.bridge) {
+      reason = `bevis för ${vessel._underBridgeCrossedBridge}`;
+    } else if (!Number.isFinite(ageMs) || ageMs < 0 || ageMs > DEFERRED_ZONE_PROOF_MAX_AGE_MS) {
+      reason = 'för gammalt';
+    } else {
+      const bridge = this.bridgeRegistry && typeof this.bridgeRegistry.getBridgeByName === 'function'
+        ? this.bridgeRegistry.getBridgeByName(rec.bridge)
+        : null;
+      const distM = bridge && Number.isFinite(bridge.lat) && Number.isFinite(bridge.lon)
+        && Number.isFinite(vessel.lat) && Number.isFinite(vessel.lon)
+        ? geometry.calculateDistance(vessel.lat, vessel.lon, bridge.lat, bridge.lon)
+        : null;
+      if (!Number.isFinite(distM) || distM > UNDER_BRIDGE_CLEAR_DISTANCE) {
+        reason = 'båten har lämnat zonen';
+      }
+    }
+    if (reason) {
+      vessel._underBridgeDeferredProof = null;
+      this.logger.debug(
+        `🧹 [UNDER_BRIDGE_DEFERRED_PROOF_DROPPED] ${vessel.mmsi}: ${rec.bridge} — ${reason}`,
+      );
+    }
+  }
