+        && vessel.sog > PASSAGE_TIMING.MINIMUM_VIABLE_SPEED) {
+      const backward = tAfter - (currentDistance / (vessel.sog * KNOTS_TO_MS)) * 1000;
+      return Math.min(tAfter, Math.max(linear, backward));
+    }
+    return linear;
   }
 
