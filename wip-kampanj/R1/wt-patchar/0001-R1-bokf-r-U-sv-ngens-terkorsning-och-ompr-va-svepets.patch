@@ -6701,7 +6708,11 @@ class VesselDataService extends EventEmitter {
     const oppositeDirection = direction === 'north' ? 'south' : 'north';
     if (!beforeBridge(vessel, target, oppositeDirection)) return null;
 
-    this._confirmDirectionReversal(vessel, direction, `två rena positionsben, ${Math.round(netM)} m netto`);
+    // R1: samma bekräftelsesegment som Fix D-grenen — det andra benet kan ha
+    // korsat en bro som den gamla resan redan bokfört.
+    this._confirmDirectionReversal(vessel, direction, `två rena positionsben, ${Math.round(netM)} m netto`, {
+      reCrossSegmentStart: this._cleanReCrossSegmentStart(vessel, oldVessel),
+    });
     return direction;
   }
 
@@ -6730,9 +6741,25 @@ class VesselDataService extends EventEmitter {
    * HELT onotifierad på returresan. Speglar NEW_JOURNEY-resetten:
    * nollställ passedBridges och låt app-lagret rensa dedup
    * (session + persistent) via eventet.
+   *
+   * R1 (rättningskampanjen 2026-11-04, F10/W750): `reCrossSegmentStart` är
+   * bekräftelsesegmentets startpunkt och skickas BARA av de två vägar som
+   * bekräftar vändningen före tickens detektering: Fix D:s COG-debounce och
+   * positionsbevisets två ben. Där har ingen bro bokförts i den nya
+   * riktningen ännu, så en bro BAKOM båten är inte "nya benets nyss korsade"
+   * (premissen nedan) — ligger den strikt mellan segmentets ändpunkter och
+   * korsades i den nya riktningen är den GAMLA resans post och returpassagen
+   * har just skett. Den släpps då som en bro framför: dedup rensas och
+   * tickens vanliga detektering bokför returen (samma utfall som
+   * RE_CROSS_EVIDENCED i _handleIntermediateBridgePassage ger när
+   * korsningen kommer före bekräftelsen). Korsningsbevisvägarna skickar inte
+   * segmentet: där ÄR bron bakom den nya korsningen och ska behållas.
+   * @param {Object} [options]
+   * @param {Object|null} [options.reCrossSegmentStart] - segmentets start
+   *   (rent, se _cleanReCrossSegmentStart) eller null
    * @private
    */
-  _confirmDirectionReversal(vessel, newDir, reason) {
+  _confirmDirectionReversal(vessel, newDir, reason, { reCrossSegmentStart = null } = {}) {
     // Den gamla resans GPS-ankare får inte återspela en tidigare korsning
     // efter att en verklig vändning redan har bekräftats.
     vessel._passageRecoveryPosition = null;
@@ -6779,12 +6806,25 @@ class VesselDataService extends EventEmitter {
         if (!b || !Number.isFinite(b.lat) || !Number.isFinite(vessel.lat)) return true; // okänd geometri → konservativ full N1
         return newDir === 'north' ? b.lat > vessel.lat : b.lat < vessel.lat;
       };
-      const bridgesToReset = vessel.passedBridges.filter(aheadInNewDir);
+      // R1: återkorsad i bekräftelsesegmentet (se docblocket). Samma bevis
+      // som RE_CROSS_EVIDENCED och korsningsbevis-reversalen använder.
+      const reCrossedInSegment = (bridgeName) => {
+        if (!reCrossSegmentStart) return false;
+        const b = this.bridgeRegistry.getBridgeByName(bridgeName);
+        return this._evidencedCrossingDirection(vessel, reCrossSegmentStart, b) === newDir;
+      };
+      const reCrossedBridges = vessel.passedBridges.filter(
+        (b) => !aheadInNewDir(b) && reCrossedInSegment(b),
+      );
+      const bridgesToReset = vessel.passedBridges.filter(
+        (b) => aheadInNewDir(b) || reCrossedBridges.includes(b),
+      );
       const keptBridges = vessel.passedBridges.filter((b) => !bridgesToReset.includes(b));
       if (bridgesToReset.length > 0) {
         this.logger.log(
           `🔁 [JOURNEY_RESET] ${mmsi}: Mid-journey reversal → clearing `
           + `passedBridges ahead in new direction [${bridgesToReset.join(', ')}]`
+          + `${reCrossedBridges.length > 0 ? ` (re-crossed ${newDir} in confirming segment: [${reCrossedBridges.join(', ')}])` : ''}`
           + `${keptBridges.length > 0 ? ` (keeping [${keptBridges.join(', ')}])` : ''} + requesting dedup reset`,
         );
         vessel.passedBridges = keptBridges;
@@ -6795,6 +6835,28 @@ class VesselDataService extends EventEmitter {
     }
   }
 
+  /**
+   * R1 (rättningskampanjen 2026-11-04): bekräftelsesegmentets start för
+   * N1-resetten, eller null när segmentet inte är ett rent korsningsbevis.
+   * Startpunkten är densamma som tickens detektering mäter från
+   * (GPSJumpAnalyzer.passageSegmentStart), och GPS-kravet är detsamma som
+   * RE_CROSS_EVIDENCED:s: ett flaggat fix i någon ände får aldrig släppa en
+   * bokförd bro (ECHO-sampel 400 m bakåt "korsar" annars den nyss passerade
+   * bron i motsatt riktning).
+   * @param {Object} vessel - tickens fartygsobjekt
+   * @param {Object|null} oldVessel - föregående fartygsobjekt
+   * @returns {Object|null}
+   * @private
+   */
+  _cleanReCrossSegmentStart(vessel, oldVessel) {
+    if (!vessel || !oldVessel) return null;
+    if (vessel._gpsJumpDetected === true || vessel._positionUncertain === true) return null;
+    const start = GPSJumpAnalyzer.passageSegmentStart(oldVessel);
+    if (!start || start._gpsJumpDetected === true || start._positionUncertain === true) return null;
+    if (!Number.isFinite(start.lat) || !Number.isFinite(vessel.lat)) return null;
+    return start;
+  }
+
   /**
    * Belagd korsningsriktning: när bron ligger STRIKT mellan förra och nya
    * positionen är korsningens riktning bevisad av positionsdeltat —
