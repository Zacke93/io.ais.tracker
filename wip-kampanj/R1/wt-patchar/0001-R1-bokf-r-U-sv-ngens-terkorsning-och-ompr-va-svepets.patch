diff --git a/app.js b/app.js
index 3a109b8..f7ba4b2 100755
--- a/app.js
+++ b/app.js
@@ -8519,12 +8519,33 @@ class AISBridgeApp extends Homey.App {
     // direction-token som 'unknown' i samma millisekund som svepet visste
     // 'north'. Lås bara när riktning saknas — motsägelser mot ett
     // befintligt lås hanteras av korsningsbevis-reversalen i VDS.
+    //
+    // R1 (rättningskampanjen 2026-11-04, F15 IRMA): svepets riktning är
+    // NETTOFÖRFLYTTNINGEN sedan sist kända position, inte nödvändigtvis
+    // färdriktningen nu. Vände båten i glappet (norrut förbi Olidebron,
+    // U-sväng, söderut igen) pekar svepet norrut medan båten går söderut,
+    // och ett lås från svepet omprövas aldrig: mållös båt ⇒ ingen Fix D,
+    // ingen bokförd bro att korsa igen ⇒ ingen korsningsbevis-reversal.
+    // Låset sätts därför inte när den RÖRELSEBEVISADE levande kursen
+    // (_dedupDirection med requireMovement: Fix D:s band och 2 kn, samma
+    // krav som reborn-grenen i journey-reset-hanteraren) säger motsatsen.
+    // SISU-skälet (tokenen blev 'unknown') gäller inte då — tokenen faller
+    // till den levande kursen. Osäker kurs eller samma riktning låser som förut.
     if (!vessel._routeDirection && (direction === 'north' || direction === 'south')) {
-      vessel._routeDirection = direction;
-      this.log(
-        `🧭 [SKIPPED_BRIDGES_DIRECTION_LOCK] ${vessel.mmsi}: route direction '${direction}' `
-        + 'locked from evidenced sweep window',
-      );
+      const liveDirection = this._dedupDirection(vessel, { requireMovement: true });
+      if (liveDirection && liveDirection !== direction) {
+        this.log(
+          `🧭 [SKIPPED_BRIDGES_DIRECTION_LOCK_SKIP] ${vessel.mmsi}: sweep window says '${direction}' `
+          + `but movement-proven live course says '${liveDirection}' (cog=${vessel.cog}°, sog=${vessel.sog}) `
+          + '— turned during the gap, route direction left unlocked',
+        );
+      } else {
+        vessel._routeDirection = direction;
+        this.log(
+          `🧭 [SKIPPED_BRIDGES_DIRECTION_LOCK] ${vessel.mmsi}: route direction '${direction}' `
+          + 'locked from evidenced sweep window',
+        );
+      }
     }
 
     // Körning 2026-07-02 (YEMANJA II): failsafen var notis-enbart. När hoppet
