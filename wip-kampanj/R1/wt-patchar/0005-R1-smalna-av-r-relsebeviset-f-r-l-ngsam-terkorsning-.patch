+  /**
+   * R1 (rättningskampanjen 2026-11-04): rörelsebeviset för en LÅNGSAM
+   * återkorsning i RE_CROSS_EVIDENCED, när korsningsfixet går under Fix
+   * D-tröskeln (2 kn) och fartkravet där därför inte räcker.
+   *
+   * FALLET (granskningen): Fix D:s väntande fix (omvänd kurs i ≥ 2 kn) och
+   * NÄSTA fix ligger på var sin sida om en bro som båten redan bokfört, och
+   * nästa fix går under 2 kn. Fix D hoppar över ticken (Anomali 5) och
+   * fartkravet likaså. Vändningen bekräftas på fixen efter, vars segment inte
+   * innehåller bron, så returen bokfördes aldrig.
+   *
+   * VARFÖR SÅ SMALT (omgranskningen 2026-11-04, medel): den första formen
+   * ("en färsk väntan i korsningens riktning och ett segment på 100 m räcker",
+   * väntan upp till FIX_D_PENDING_MAX_AGE_MS gammal) vände en VÄNTANDE båt på
+   * ett enda GPS-sprang. AQUILA (265735370, korpus 20260601-41h) låg 51–89 m
+   * söder om Stridsbergsbron i 0–0,1 kn; en manöverrapport i 2,8 kn satte en
+   * äkta väntan norrut 13:37:08, och en inlagd outlier 53 m norr om bron
+   * 13:42:40 (segment 118 m, 0,1 kn, godtagen av fysikgrindens 1 kn-golv)
+   * gav en falsk reversal och "Inga båtar" i 11,5 min. Ingen av de två
+   * observationerna visade rörelse i nuet (S-F4: en ensam outlier hos en
+   * stillaliggande båt bevisar ingenting; PIANO: rörelse i nuet).
+   *
+   * Beviset kräver därför ALLA fyra:
+   *  (1) Väntan sattes på segmentets startfix, och startfixet är förra fixet
+   *      självt (inget GPS-återhämtningssegment). Anomali 18:s två
+   *      observationer blir två på varandra följande fixar: omvänd kurs i
+   *      ≥ 2 kn och sedan korsningen. En äldre väntan, med fixar emellan som
+   *      Fix D varken bekräftat eller nollat (de gick under 2 kn), säger inget
+   *      om rörelsen nu.
+   *  (2) Korsningsfixet rör sig självt: fixens EGEN fart
+   *      (GPSJumpAnalyzer.positionSog, inte det framförda sog-värdet) är minst
+   *      QUAY_DEPARTURE_GATE.TRANSIT_SOG_KN (1,0 kn), samma transitgräns som
+   *      ProximityService._hasContinuingPassageJourney läser på råfixen. En
+   *      outlier bär båtens verkliga fart, och den är nära noll hos en båt som
+   *      ligger still. Under 1 kn räknar fysikgrinden dessutom med golvet 1 kn
+   *      och kan inte skilja ett sprang från rörelse.
+   *  (3) Segmentet är klart bortom GPS-brus: minst 100 m (vobbelskyddet, samma
+   *      gräns som för fartgivarlösa båtar ovan).
+   *  (4) Segmentets nettofart når Fix D:s 2 kn: avståndet delat med
+   *      fixseparationen (GPSJumpAnalyzer.fixDtMs; mottagningstid som
+   *      reserv, som _northProgressMps). Båten har då gjort väg över hela
+   *      segmentet i stället för att cirkla på stället.
+   *
+   * KVAR SOM KÄND LUCKA (U18): en återkorsning där korsningsfixet går under
+   * 1 kn (båten stannar direkt efter bron), där väntan är äldre än startfixet
+   * eller där segmentet är kortare än 100 m bokförs inte. I bankens facit går
+   * 8 av 790 verkliga linjekorsningar från ≥ 2 kn till under 1 kn på
+   * korsningsfixet (K/R1/DESIGN.md §7.3).
+   *
+   * @param {Object} vessel - tickens fartygsobjekt (korsningsfixet)
+   * @param {Object} previousVessel - föregående fartygsobjekt
+   * @param {Object} segmentStart - segmentets start (passageSegmentStart)
+   * @param {string|null} reCrossDir - korsningens belagda riktning
+   * @param {number} segmentM - segmentets längd i meter
+   * @returns {{sogKn: number, netKn: number}|null} beviset, eller null
+   * @private
+   */
+  _slowReCrossEvidence(vessel, previousVessel, segmentStart, reCrossDir, segmentM) {
+    if (!segmentStart || segmentStart !== previousVessel) return null;
+    if (!this._hasFreshFixDPending(vessel, reCrossDir)) return null;
+    if (!Number.isFinite(segmentStart.timestamp)
+        || vessel._fixDPendingReversal.time < segmentStart.timestamp) return null;
+    const sogKn = GPSJumpAnalyzer.positionSog(vessel);
+    if (sogKn === null || sogKn < constants.QUAY_DEPARTURE_GATE.TRANSIT_SOG_KN) return null;
+    if (!Number.isFinite(segmentM) || segmentM < 100) return null;
+    const fixDtMs = GPSJumpAnalyzer.fixDtMs(vessel, segmentStart);
+    const dtMs = fixDtMs !== null
+      ? fixDtMs
+      : Math.max(vessel.lastPositionUpdate || 0, vessel.timestamp || 0)
+        - Math.max(segmentStart.lastPositionUpdate || 0, segmentStart.timestamp || 0);
+    if (!(dtMs > 0)) return null;
+    const netKn = (segmentM / 1852) / (dtMs / 3600000);
+    if (netKn < 2.0) return null;
+    return { sogKn, netKn };
+  }
+
