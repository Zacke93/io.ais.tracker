+  /**
+   * Fix D:s väntande vändning i riktningen `dir`, färskare än
+   * FIX_D_PENDING_MAX_AGE_MS. Väntan sätts bara av en omvänd kurs i ≥ 2 kn
+   * (Fix D:s band, Anomali 5) och är därmed EN rörelsebevisad observation av
+   * vändningen. Fix D:s bekräftelse och RE_CROSS_EVIDENCED läser samma
+   * predikat (R1, rättningskampanjen 2026-11-04).
+   * @param {Object} vessel - fartygsobjektet
+   * @param {string|null} dir - 'north' eller 'south'
+   * @returns {boolean}
+   * @private
+   */
+  _hasFreshFixDPending(vessel, dir) {
+    const pending = vessel?._fixDPendingReversal;
+    return Boolean(pending)
+      && (dir === 'north' || dir === 'south')
+      && pending.dir === dir
+      && Number.isFinite(pending.time)
+      && (Date.now() - pending.time) < constants.FIX_D_PENDING_MAX_AGE_MS;
+  }
