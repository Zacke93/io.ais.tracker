-    expect(tidigare).toBeGreaterThanOrEqual(3);
-  });
-
-  test.each([
-    ['A'],
-    ['B'],
-  ])('R1, AISHub, klass %s: raderna mottagna före avgången är bitlika, och första fixen efter avgången kommer aldrig senare än i den gamla modellen', (cls) => {
