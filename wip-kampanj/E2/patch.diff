+/**
+ * Familj E2 (rättningskampanjen 2026-11-04): ETA-ETAPPEN enligt U20.
+ *
+ * K6 (ARCHITECTURE §8 (e)): meddelandevägen och snapshot-vägen räknade SAMMA
+ * AIS-fix två gånger, och båda passen muterade ProgressiveETACalculator —
+ * dubbel EMA per fix. Dubbelkörningen bar oavsiktligt last, så den ersätts av
+ * tre delar som går in TILLSAMMANS:
+ *   1. glapp-reseten behåller fixets eget fartsampel och etablerar sin nya
+ *      baslinje från det värde fixet publicerar på den gamla bufferten; fixets
+ *      färska skattning prövas mot den baslinjen (pass 2:s skyddseffekt);
+ *   2. outliergrindens fönster är kadensrelativt (1,5 av fartygets eget
+ *      fixintervall, mätt före fixet, men minst det gamla 30 s-fönstret) i
+ *      stället för 30 s väggtid; ett dramatiskt fall mäts mot förra värdet
+ *      minus förfluten tid, och två fix i följd bekräftar ett fall;
+ *   3. utjämningens vikt per fix kalibrerades efter 1 och 2: 0,64.
+ * Därtill två kort ur buggjägaren:
+ *   F06 (värld 192, XENIA): "strax → om 4 → strax" vid inbromsning. Medelfarten
+ *       i fartbufferten ligger efter en inbromsning; den får inte ensam lova
+ *       strax när momentanfarten säger ≥ 3 min (M9-principen).
+ *   F07 (20260708-21h, δ −11,52 s, AVALON): spärren (RC4) jämförde en färsk
+ *       mätning med appens egen extrapolerade gissning, som ingen såg — en
+ *       annan båt ledde gruppen. Gissningen blir spärrens baslinje bara när den
+ *       är värdet brotexten visar (SISU 21h och IDUN 25h är oförändrade).
+ */
+
+const path = require('path');
+const { execFileSync } = require('child_process');
+const BridgeRegistry = require('../lib/models/BridgeRegistry');
+const ProgressiveETACalculator = require('../lib/services/ProgressiveETACalculator');
+const geometry = require('../lib/utils/geometry');
+const { BRIDGES } = require('../lib/constants');
+const { validateInvariants } = require('./replay-validation/invariants');
+const AISBridgeApp = require('../app');
+
+global.__TEST_MODE__ = true;
+
+const ROOT = path.resolve(__dirname, '..');
+const RUNNER = path.join(ROOT, 'tests/replay-validation/replayRunner.js');
+const FIXTURES = path.join(__dirname, 'fixtures');
+const KLAFF = BRIDGES.klaffbron;
+const M_PER_DEG_LAT = 111320;
+const KN_M_PER_MIN = 1852 / 60;
+const MMSI = '265039053';
+
+function makeLogger() {
+  return {
+    log: jest.fn(), debug: jest.fn(), error: jest.fn(), warn: jest.fn(),
+  };
+}
+
+const lines = (logger, tag) => logger.debug.mock.calls.map((c) => String(c[0])).filter((s) => s.includes(tag));
+
+/** Ett AIS-fix `metres` söder om Klaffbron, på väg norrut mot den. */
+function fixAt(metres, sog, extra = {}) {
+  return {
+    mmsi: MMSI,
+    targetBridge: 'Klaffbron',
+    status: 'approaching',
+    lat: KLAFF.lat - metres / M_PER_DEG_LAT,
+    lon: KLAFF.lon,
+    sog,
+    cog: 20,
+    timestamp: Date.now(),
+    lastPositionUpdate: Date.now(),
+    ...extra,
+  };
+}
+
+/** Rå-ETA:n direkt mot Klaffbron i en given fart (direktmetoden, ingen rutt). */
+function rawAt(vessel, kn) {
+  return geometry.calculateDistance(vessel.lat, vessel.lon, KLAFF.lat, KLAFF.lon) / (kn * KN_M_PER_MIN);
+}
+
+/** Som appen: meddelandevägen och snapshot-vägen anropar båda för samma fix. */
+function bothPaths(calc, vessel) {
+  const message = calc.calculateProgressiveETA(vessel, null);
+  const snapshot = calc.calculateProgressiveETA(vessel, null);
+  return { message, snapshot };
+}
+
+function runReplay(jsonlPath) {
+  const env = { ...process.env, NODE_OPTIONS: '', REPLAY_VERBOSE: '' };
+  delete env.REPLAY_MONITORING;
+  const out = execFileSync(process.execPath, [RUNNER, jsonlPath], {
+    cwd: ROOT, encoding: 'utf8', maxBuffer: 64 * 1024 * 1024, env,
+  });
+  return JSON.parse(out.match(/__REPLAY_JSON__(.*?)__END__/s)[1]);
+}
+
+const etaViolations = (result) => validateInvariants(result)
+  .filter((v) => /ETA-OSCILLATION|ETA-SÅGTAND/.test(v));
+
+describe('K6: en beräkning per AIS-fix', () => {
