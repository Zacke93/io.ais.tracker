+  test('samma fix via båda vägarna ger samma värde, en historikpost och vikten 0,64', () => {
+    const first = calc.calculateProgressiveETA(fixAt(1500, 4), null);
+    jest.advanceTimersByTime(60000);
+    const v = fixAt(1377, 4);
+    const { message, snapshot } = bothPaths(calc, v);
+
+    expect(snapshot).toBe(message); // ingen andra utjämning av samma fix
+    expect(calc._etaHistory.get(MMSI)).toHaveLength(2);
+    expect(message).toBeCloseTo(0.64 * rawAt(v, 4) + 0.36 * first, 6);
+    expect(lines(logger, '[ETA_FIX_MEMO]')).toHaveLength(1);
