+describe('Ledarurvalet följer brotexten, och Fix G:s registrering avgörs efter loopen', () => {
+  const boat = (mmsi, etaMinutes, extra = {}) => ({
+    mmsi, targetBridge: 'Klaffbron', etaMinutes, ...extra,
+  });
+
+  test('en filtrerad båt med lägre ETA hindrar inte ledaren som brotexten visar', () => {
+    const shown = boat('1', 9);
+    const filtered = boat('2', 4); // t.ex. BRIDGE_TEXT_FILTER: för långsam
+    const ctx = {
+      vesselDataService: {
+        getVesselsForBridgeText: () => [shown],
+        getAllVessels: () => [shown, filtered],
+      },
+    };
+    expect(AISBridgeApp.prototype._leadsEtaGroup.call(ctx, shown, 9)).toBe(true);
+    // Den filtrerade båten syns inte själv och leder därför inte.
+    expect(AISBridgeApp.prototype._leadsEtaGroup.call(ctx, filtered, 4)).toBe(false);
+  });
+
+  test('en ETA på 0 räknas inte som giltig (isValidETA)', () => {
+    const a = boat('1', 9);
+    const zero = boat('2', 0);
+    const ctx = { vesselDataService: { getVesselsForBridgeText: () => [a, zero], getAllVessels: () => [a, zero] } };
+    expect(AISBridgeApp.prototype._leadsEtaGroup.call(ctx, a, 9)).toBe(true);
+  });
+
+  test('i snapshot-loopen registreras gissningen först efter loopen, mot passets värden', () => {
+    const a = boat('1', 12);
+    const b = boat('2', 14);
+    const ctx = {
+      debug: jest.fn(),
+      vesselDataService: { getVesselsForBridgeText: () => [a, b] },
+      _pendingPublishedNotes: [],
+    };
+    for (const name of ['_notePublishedETA', '_applyPublishedNote', '_flushPublishedNotes', '_leadsEtaGroup']) {
+      ctx[name] = AISBridgeApp.prototype[name].bind(ctx);
+    }
+    ctx._notePublishedETA(b, 11.5, 1000, 'extrapolerad');
+    expect(b._etaPublishedValue).toBeUndefined();
+    // Senare i samma pass sjunker a:s värde — b leder inte efter passet.
+    a.etaMinutes = 10;
+    ctx._flushPublishedNotes();
+    expect(b._etaPublishedValue).toBeUndefined();
+    expect(ctx.debug.mock.calls.some((c) => String(c[0]).includes('[ETA_PUBLISH_UNSEEN]'))).toBe(true);
+    expect(ctx._pendingPublishedNotes).toBeNull();
+  });
+});
