+  afterEach(() => {
+    jest.useRealTimers();
+  });
+
+  const reconcile = (vessel, fresh) => AISBridgeApp.prototype._reconcilePublishedETA.call({
+    debug: jest.fn(),
+    bridgeRegistry: null,
+    vesselDataService: { getVesselsForBridgeText: () => [vessel] },
+  }, vessel, fresh);
+  const avalon = (ageMs) => ({
+    mmsi: '219009353',
+    targetBridge: 'Klaffbron',
+    _etaPublishTarget: 'Klaffbron',
+    _etaPublishedValue: 30.3,
+    _etaPublishedAtMs: NOW - ageMs,
+  });
+
+  test('AVALON: färska 11,9 mot hennes egen 30,3 från 5,04 min tidigare går igenom', () => {
+    expect(reconcile(avalon(302377), 11.9)).toBeCloseTo(11.9, 5);
+  });
+
+  test('en baslinje inom fem minuter dämpar som förut (SISU 3,5 min, IDUN 3,0 min)', () => {
+    const v = avalon(3.5 * 60000);
+    // maxDelta = max(3, 3,5 + 0,25 · 30,3)
+    expect(reconcile(v, 11.9)).toBeCloseTo(30.3 - (3.5 + 0.25 * 30.3), 5);
+  });
+
+  test('ett hopp UPPÅT mot en inaktuell baslinje dämpas fortfarande (NOCHT 41h)', () => {
+    const v = avalon(6 * 60000);
+    const max = 30.3 + (6 + 0.25 * 30.3);
+    expect(reconcile(v, 60)).toBeCloseTo(max, 5);
+  });
+
+  test('21h-varianten och basen: AVALON visas nära sanningen, ingen sågtand', () => {
+    const variant = runReplay(path.join(FIXTURES, 'e2-f07-avalon-21h-variant.jsonl'));
+    const bas = runReplay(path.join(FIXTURES, 'e2-f07-avalon-21h-bas.jsonl'));
+    for (const r of [variant, bas]) {
+      expect(validateInvariants(r).filter((v) => /ETA-OSCILLATION|ETA-SÅGTAND/.test(v))).toEqual([]);
+    }
+    // Värdet som står 07:11:30, när JÄÄTTEN nollats och AVALON leder. AVALON
+    // korsar 07:16:01 (inferred, 4,5 min). Förut "om 18".
+    const shownAt = (r, iso) => {
+      const before = r.bridgeTextTransitions.filter((t) => t.iso <= iso);
+      const text = before[before.length - 1].text.split('; ')[0];
+      return Number((text.match(/om (?:cirka )?(\d+) minut/) || [])[1]);
+    };
+    const v = shownAt(variant, '2026-07-08T07:11:30.040Z');
+    const b = shownAt(bas, '2026-07-08T07:11:30.040Z');
+    expect(v).toBeLessThanOrEqual(12);
+    expect(b).toBeLessThanOrEqual(12);
+    expect(Math.abs(v - b)).toBeLessThanOrEqual(1);
+  });
