diff --git a/lib/services/ProgressiveETACalculator.js b/lib/services/ProgressiveETACalculator.js
index fc4a29e..445d0f6 100644
--- a/lib/services/ProgressiveETACalculator.js
+++ b/lib/services/ProgressiveETACalculator.js
@@ -153,9 +153,12 @@ function sampleKeyOf(vessel) {
 //      baslinjen genom hela skyddskedjan, med GAP_BASELINE_ALPHA. Det är exakt
 //      den skyddseffekt pass 2 råkade ge.
 //   2. OUTLIER_WINDOW_CADENCE_FACTOR: outliergrindens dramatiska grenar gäller
-//      inom 1,5 av fartygets EGNA fixintervall (minst 30 s, högst glappgränsen),
-//      inte inom 30 s väggtid — annars lever skyddet bara i en andra körning.
+//      inom 1,5 av fartygets EGET fixintervall, mätt FÖRE fixet, men aldrig
+//      inom kortare tid än det gamla fönstret 30 s. Mellan två fix levde
+//      skyddet tidigare bara i dubbelkörningens andra pass.
 //   3. EMA_ALPHA_PER_FIX kalibrerades EFTER de två ovan.
+// Avgångskontextens not ovan ("K6 rörs inte") gäller familj E:s leverans; E2
+// ändrar K6 här och lämnar avgångskontexten orörd.
 const GAP_RESET_MS = 3 * 60 * 1000;
 
 // E2 (K6, del 1): vikten för fixets färska skattning mot glappbaslinjen. Samma
@@ -163,9 +166,26 @@ const GAP_RESET_MS = 3 * 60 * 1000;
 // glappets skyddseffekt behålls oförändrad.
 const GAP_BASELINE_ALPHA = 0.4;
 
-// E2 (K6, del 2): outliergrindens fönster i fartygets egen kadens. 1,5 intervall
-// = "nästa fix" med marginal för kadensens spridning; golvet 30 s är det gamla
-// fönstret (tät kadens), taket är glappgränsen (äldre historik nollställs ändå).
+// E2 (K6, del 2): outliergrindens fönster i fartygets egen kadens. Kadensen är
+// ett glidande medel av intervallen mellan beräknade fix UTAN glapp, och
+// fönstret läser den så som den var FÖRE fixet (den uppdateras efter
+// prövningen). 1,5 intervall = "nästa fix", med marginal för kadensens
+// spridning. Golvet 30 s är det gamla fönstret: i tät kadens prövas lika
+// mycket som förut, och okänd kadens (ny båt, eller ingen glappfri följd ännu)
+// får just det. Glappsteget (del 1) prövar två skattningar av samma fix med
+// tidsavstånd 0 och ryms alltid. Vid 30 s kadens höll dubbelkörningen en
+// väntande båt av en slump (nästa pass 1 kom 29,96 s efter pass 2); här håller
+// kadensen den.
+// PRÖVAT OCH ÅTERTAGET (mätt, docs/VALIDATION.md §ETA-mätharnessen "Familj E2"):
+//   - HALV kadens ("samma mätomgång"): en väntande båt i 30 s kadens prövades
+//     aldrig, och ETA:n växte en minut per fix (E:s syntetiska väntan före
+//     Klaffbron: om 6 → om 13; e949ae1 höll om 6);
+//   - kadensen uppdaterad FÖRE prövningen: intervallet täckte då alltid sig
+//     självt, så första fixet efter ett glapp prövades mot glappsteget. Det höll
+//     en båt som stannade på sin gamla siffra (BARAVI 20260804-17h 09:28:42:
+//     19,5 min mot sanning 25,5; dubbelkörningen gav 24,5), flyttade
+//     Klaffbron#13:s konvojtäckning 5 min och gav en öppningsvarning 3,8 min
+//     EFTER CYGNUS verkliga passage.
 const OUTLIER_WINDOW_CADENCE_FACTOR = 1.5;
 const OUTLIER_WINDOW_MIN_MS = 30 * 1000;
 
@@ -1338,16 +1358,12 @@ class ProgressiveETACalculator {
     // publicerings-clampen; vinsten är att alla skyddssteg ser en tömd
     // historik uniformt från och med NÄSTA beräkning.
     const gapReset = this._applyGapResetIfNeeded(vessel, history, now);
-    if (!gapReset && !this._inGapStep && history.length > 0) {
-      // E2 (K6, del 2): fartygets kadens = intervallet mellan två beräknade
-      // fix utan glapp (glidande medel), läses av outliergrindens fönster.
-      const interval = now - history[history.length - 1].timestamp;
-      const prevCad = this._fixCadence.get(mmsi);
-      this._fixCadence.set(mmsi, {
-        intervalMs: prevCad && Number.isFinite(prevCad.intervalMs)
-          ? 0.5 * prevCad.intervalMs + 0.5 * interval : interval,
-      });
-    }
+    // E2 (K6, del 2): fixets intervall mot förra beräknade fix (utan glapp).
+    // Kadensen uppdateras med det först EFTER outlierprövningen: fönstret ska
+    // bygga på fartygets rytm FÖRE fixet, annars täcker ett intervall alltid
+    // sig självt.
+    const cadenceIntervalMs = !gapReset && !this._inGapStep && history.length > 0
+      ? now - history[history.length - 1].timestamp : null;
 
     const distanceToTarget = this._getDistanceToTarget(vessel);
     const position = this._trustedETAPosition(vessel);
@@ -1647,6 +1663,16 @@ class ProgressiveETACalculator {
       adjustedETA = STRAX_THRESHOLD_MINUTES;
     }
 
+    if (cadenceIntervalMs !== null) {
+      // E2 (K6, del 2): fartygets kadens = intervallet mellan två beräknade
+      // fix utan glapp (glidande medel), läses av outliergrindens fönster.
+      const prevCad = this._fixCadence.get(mmsi);
+      this._fixCadence.set(mmsi, {
+        intervalMs: prevCad && Number.isFinite(prevCad.intervalMs)
+          ? 0.5 * prevCad.intervalMs + 0.5 * cadenceIntervalMs : cadenceIntervalMs,
+      });
+    }
+
     // STEP 6: RECORD HISTORY - Store this calculation for future reference
     this._recordETAHistory(mmsi, {
       rawETA,
@@ -1733,11 +1759,11 @@ class ProgressiveETACalculator {
    * @private
    */
   _outlierWindowMs(vessel) {
-    // Okänd kadens (andra fixet efter en tömd historik): föregående post är
-    // per definition fixet före, så fönstret täcker allt inom glappgränsen.
+    // Kadensen FÖRE fixet (uppdateras efter prövningen). Okänd kadens: det
+    // gamla fönstret. Glappstegets två skattningar (tidsavstånd 0) ryms alltid.
     const cad = this._fixCadence.get(String(vessel.mmsi));
-    if (!cad || !Number.isFinite(cad.intervalMs)) return GAP_RESET_MS;
-    return Math.min(GAP_RESET_MS, Math.max(OUTLIER_WINDOW_MIN_MS, OUTLIER_WINDOW_CADENCE_FACTOR * cad.intervalMs));
+    if (!cad || !Number.isFinite(cad.intervalMs)) return OUTLIER_WINDOW_MIN_MS;
+    return Math.max(OUTLIER_WINDOW_MIN_MS, OUTLIER_WINDOW_CADENCE_FACTOR * cad.intervalMs);
   }
 
   /**
