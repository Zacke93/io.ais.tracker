@@ -180,25 +181,77 @@ describe('K6 del 1: glapp-reseten etablerar en baslinje i stället för ingentin
 });
 
 describe('K6 del 2: outliergrindens fönster följer fartygets kadens', () => {
-  test('ett dramatiskt fall mellan två fix i 70 s kadens fångas utan en andra körning', () => {
+  let calc; let logger;
+
+  beforeEach(() => {
     jest.useFakeTimers({ now: Date.parse('2026-07-15T09:00:00Z') });
-    const logger = makeLogger();
-    const calc = new ProgressiveETACalculator(logger, new BridgeRegistry());
-    try {
-      calc.calculateProgressiveETA(fixAt(2000, 4), null);
-      jest.advanceTimersByTime(70000);
-      calc.calculateProgressiveETA(fixAt(1856, 4), null);
-      jest.advanceTimersByTime(70000);
-      calc.calculateProgressiveETA(fixAt(1712, 4), null);
-      jest.advanceTimersByTime(70000);
-      // Positionsglimt: 1 300 m närmare på 70 s (rå-ETA:n under 40 % av förra).
-      calc.calculateProgressiveETA(fixAt(400, 4), null);
-      expect(lines(logger, 'dramatic_decrease')).toHaveLength(1);
-      expect(lines(logger, '[ETA_FALLBACK] 265039053: Using fallback')).toHaveLength(1);
-    } finally {
-      calc.destroy();
-      jest.useRealTimers();
+    logger = makeLogger();
+    calc = new ProgressiveETACalculator(logger, new BridgeRegistry());
+  });
+
+  afterEach(() => {
+    calc.destroy();
+    jest.useRealTimers();
+  });
+
+  test('ett dramatiskt fall till nästa fix i 150 s kadens fångas utan en andra körning', () => {
+    // 150 s kadens (AISHubs p50). Nästa fix har en positionsglimt 1 300 m
+    // närmare: rå-ETA:n under 40 % av förra, 150 s efter — bortom det gamla
+    // 30 s-fönstret men inom 1,5 × kadensen.
+    calc.calculateProgressiveETA(fixAt(2300, 4), null);
+    jest.advanceTimersByTime(150000);
+    calc.calculateProgressiveETA(fixAt(1990, 4), null);
+    jest.advanceTimersByTime(150000);
+    calc.calculateProgressiveETA(fixAt(1680, 4), null);
+    jest.advanceTimersByTime(150000);
+    calc.calculateProgressiveETA(fixAt(400, 4), null);
+    expect(lines(logger, 'dramatic_decrease')).toHaveLength(1);
+    expect(lines(logger, '[ETA_FALLBACK] 265039053: Using fallback')).toHaveLength(1);
+  });
+
+  test('i 30 s kadens prövas nästa fix — dubbelkörningen gjorde det bara av en slump', () => {
+    // Exakt 30 s ligger utanför det gamla fönstret (< 30 s); pass 1 kom förut
+    // 29,96 s efter pass 2 och hölls därför. Kadensfönstret är 45 s. Prövat
+    // och återtaget: HALV kadens (15 s) prövade aldrig nästa fix, och E:s
+    // syntetiska väntan före Klaffbron växte "om 6 → om 13".
+    calc.calculateProgressiveETA(fixAt(1000, 4), null);
+    jest.advanceTimersByTime(30000);
+    calc.calculateProgressiveETA(fixAt(938, 4), null);
+    jest.advanceTimersByTime(30000);
+    const v = fixAt(300, 4);
+    expect(calc._outlierWindowMs(v)).toBe(45000);
+    calc.calculateProgressiveETA(v, null);
+    expect(lines(logger, 'dramatic_decrease')).toHaveLength(1);
+  });
+
+  test('tät kadens prövas minst som förut: golvet är det gamla 30 s-fönstret', () => {
+    // 10 s kadens ger 1,5 × kadensen = 15 s; ett fix 25 s senare (två tappade)
+    // ligger inom det gamla fönstret och prövas fortfarande.
+    let m = 2000;
+    for (let i = 0; i < 4; i++) {
+      calc.calculateProgressiveETA(fixAt(m, 4), null);
+      jest.advanceTimersByTime(10000);
+      m -= 21;
     }
+    jest.advanceTimersByTime(15000);
+    calc.calculateProgressiveETA(fixAt(500, 4), null);
+    expect(lines(logger, 'dramatic_decrease')).toHaveLength(1);
+  });
+
+  test('efter ett glapp är kadensen okänd: en båt som stannar får sin ETA att växa (BARAVI 17h)', () => {
+    // Prövat och återtaget: kadensen uppdaterad FÖRE prövningen täckte alltid
+    // sitt eget intervall (1,5 × 110 s), så fixet efter glappsteget prövades
+    // dramatiskt och hölls. BARAVI fick 19,5 min mot sanning 25,5; det
+    // flyttade en konvojtäckning och gav en varning efter CYGNUS passage.
+    calc.calculateProgressiveETA(fixAt(1500, 4.5), null);
+    jest.advanceTimersByTime(181000);
+    const before = calc.calculateProgressiveETA(fixAt(1300, 1.0), null); // glappsteget
+    const seen = logger.debug.mock.calls.length;
+    jest.advanceTimersByTime(110000);
+    const after = calc.calculateProgressiveETA(fixAt(1290, 0.6, { status: 'en-route' }), null);
+    const later = logger.debug.mock.calls.slice(seen).map((c) => String(c[0]));
+    expect(later.filter((l) => l.includes('dramatic_'))).toHaveLength(0);
+    expect(after).toBeGreaterThan(before);
   });
 });
 
