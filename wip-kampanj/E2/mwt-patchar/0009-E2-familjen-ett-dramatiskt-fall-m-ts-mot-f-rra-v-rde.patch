 lib/services/ProgressiveETACalculator.js | 13 +++++++++++--
 tests/e2-eta-etapp-2026-11-04.test.js    | 21 ++++++++++++++++++++-
 2 files changed, 31 insertions(+), 3 deletions(-)

diff --git a/lib/services/ProgressiveETACalculator.js b/lib/services/ProgressiveETACalculator.js
index 445d0f6..a2728cc 100644
--- a/lib/services/ProgressiveETACalculator.js
+++ b/lib/services/ProgressiveETACalculator.js
@@ -1731,8 +1731,17 @@ class ProgressiveETACalculator {
 
     // Check for dramatic ETA jumps (e.g., 7min → 1min)
     const etaRatio = lastEntry.processedETA > 0 ? eta / lastEntry.processedETA : 1;
-    if (etaRatio < (1 / this._outlierThresholdMultiple) && timeDelta < windowMs) {
-      return { isOutlier: true, reason: `dramatic_decrease_${etaRatio.toFixed(2)}x` };
+    // E2 (K6, del 2): ett dramatiskt FALL mäts mot vad förra värdet förutsäger
+    // NU — förra värdet minus förfluten tid. Inom kadensfönstret jämförs två
+    // fix, och då har båten hunnit fram en bit medan den utjämnade siffran
+    // ligger efter. Mot det oförändrade förra värdet dömdes en snabb
+    // inflygning som en positionsglimt (NORDIC SAGA 20260917-7h 15:15:14: rå
+    // 2,4 min mot 6,1 en minut tidigare, kvot 0,39, hölls på 4,9 mot sanning
+    // 2,4). Glappsteget (tidsavstånd 0) och ökningsgrenen påverkas inte.
+    const expectedNow = Math.max(0.1, lastEntry.processedETA - timeDelta / 60000);
+    const decreaseRatio = eta / expectedNow;
+    if (decreaseRatio < (1 / this._outlierThresholdMultiple) && timeDelta < windowMs) {
+      return { isOutlier: true, reason: `dramatic_decrease_${decreaseRatio.toFixed(2)}x` };
     }
 
     // Check for unreasonable ETA spikes (e.g., 1min → 10min)
