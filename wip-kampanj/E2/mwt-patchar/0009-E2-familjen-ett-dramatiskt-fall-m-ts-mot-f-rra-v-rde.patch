+  test('ett fall mäts mot förra värdet minus förfluten tid: en snabb inflygning är ingen positionsglimt', () => {
+    // NORDIC SAGA 20260917-7h 15:15:14: förra fixet 6,1 min (utjämnat, efter
+    // rå 4,1) en minut tidigare, nu rå 2,4. Mot 6,1 är kvoten 0,39 och fallet
+    // dömdes som dramatiskt; mot det förväntade 5,1 är kvoten 0,47.
+    const now = Date.now();
+    const v = {
+      mmsi: MMSI, targetBridge: 'Klaffbron', status: 'approaching', sog: 5.1,
+    };
+    calc._fixCadence.set(MMSI, { intervalMs: 50000 });
+    const history = [{ timestamp: now - 60000, rawETA: 4.1, processedETA: 6.1 }];
+    expect(calc._isETAOutlier(2.4, history, v)).toEqual({ isOutlier: false, reason: 'normal_variation' });
+    // En verklig glimt (1,0 min) är fortfarande dramatisk mot det förväntade.
+    expect(calc._isETAOutlier(1.0, history, v).reason).toMatch(/^dramatic_decrease_0\.2/);
+    // Tidsavstånd 0 (glappsteget): förväntat = förra, samma kvot som förut.
+    const same = [{ timestamp: now, rawETA: 6.1, processedETA: 6.1 }];
+    expect(calc._isETAOutlier(2.4, same, v).reason).toBe('dramatic_decrease_0.39x');
+  });
+
