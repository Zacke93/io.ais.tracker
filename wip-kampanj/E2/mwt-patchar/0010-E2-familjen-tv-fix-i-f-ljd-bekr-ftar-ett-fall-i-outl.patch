     const mmsi = vessel.mmsi.toString();
+    // E2 (K6, del 2): fixets uppmätta rå-ETA, innan outlierskyddet kan byta
+    // ut den mot en blandning — historiken bär den till nästa fix.
+    const measuredETA = rawETA;
     // Familj E (F04): rå-ETA:n som den kom in (outlierskyddet nedan kan byta
     // ut rawETA mot en blandning) — M9-kravet för avgångsgolvet läser den.
     const departureMeasuredETA = this._departureMeasuredETA(vessel, rawETA);
@@ -1393,6 +1396,12 @@ class ProgressiveETACalculator {
     // ligger i serier längre än taket. Taket är alltså en SPÄRR mot en latent
     // rundgång, inte en bred beteendeändring — se rapporten.
     let outlierProtectionActive = suspiciousETA.isOutlier;
+    if (suspiciousETA.reason === 'confirmed_decrease') {
+      this.logger.debug(
+        `✅ [ETA_OUTLIER_CONFIRMED] ${mmsi}: fallet till ${rawETA.toFixed(1)}min stämmer med förra fixets `
+        + 'uppmätta värde — två fix i följd, ingen glimt',
+      );
+    }
     if (suspiciousETA.isOutlier && suspiciousETA.reason === 'gps_coordination_active') {
       const gpsStreak = this._gpsFallbackStreak.get(mmsi) || 0;
       if (gpsStreak >= GPS_FALLBACK_MAX_CONSECUTIVE) {
@@ -1676,6 +1685,8 @@ class ProgressiveETACalculator {
     // STEP 6: RECORD HISTORY - Store this calculation for future reference
     this._recordETAHistory(mmsi, {
       rawETA,
+      measuredETA,
+      heldDecrease: outlierProtectionActive && suspiciousETA.reason.startsWith('dramatic_decrease'),
       protectedETA,
       processedETA: adjustedETA,
       timestamp: now,
@@ -1740,8 +1751,23 @@ class ProgressiveETACalculator {
     // 2,4). Glappsteget (tidsavstånd 0) och ökningsgrenen påverkas inte.
     const expectedNow = Math.max(0.1, lastEntry.processedETA - timeDelta / 60000);
     const decreaseRatio = eta / expectedNow;
+    let confirmedDecrease = false;
     if (decreaseRatio < (1 / this._outlierThresholdMultiple) && timeDelta < windowMs) {
-      return { isOutlier: true, reason: `dramatic_decrease_${decreaseRatio.toFixed(2)}x` };
+      // E2 (K6, del 2): TVÅ FIX I FÖLJD BEKRÄFTAR ETT FALL. Hölls förra fixet
+      // redan som dramatiskt fall, och stämmer det här fixets rå-ETA med förra
+      // fixets UPPMÄTTA värde (minus förfluten tid), är fallet verkligt och
+      // ingen glimt. Annars jämförs varje nytt fix med en hållen siffra som
+      // aldrig hinner ikapp (MOKENDEIST 20260806-42h 12:13–12:17: rå 7,7 →
+      // 6,1 → 4,8 → 3,2 hölls 17,8 → 15,1 → 12,6 → 10,3; dubbelkörningen gav
+      // 17,8 → 10,3 → 6,8 → 4,5). Ökningar bekräftas inte så: en väntande
+      // båts rå-ETA står stadigt på fartgolvet och ska fortsatt hållas.
+      const prevMeasured = lastEntry.heldDecrease === true && Number.isFinite(lastEntry.measuredETA)
+        ? Math.max(0.1, lastEntry.measuredETA - timeDelta / 60000) : null;
+      if (prevMeasured !== null && eta / prevMeasured >= 1 / this._outlierThresholdMultiple) {
+        confirmedDecrease = true;
+      } else {
+        return { isOutlier: true, reason: `dramatic_decrease_${decreaseRatio.toFixed(2)}x` };
+      }
     }
 
     // Check for unreasonable ETA spikes (e.g., 1min → 10min)
@@ -1758,7 +1784,7 @@ class ProgressiveETACalculator {
       return { isOutlier: true, reason: 'gps_coordination_active' };
     }
 
-    return { isOutlier: false, reason: 'normal_variation' };
+    return { isOutlier: false, reason: confirmedDecrease ? 'confirmed_decrease' : 'normal_variation' };
   }
 
