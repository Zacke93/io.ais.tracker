+    jest.advanceTimersByTime(61000);
+    const next = calc.calculateProgressiveETA(passed(330, 0.7), null);
+    expect(next).toBeLessThan(6);
+  });
+
+  test('glappets färska skattning prövas mot baslinjen: ett ensamt långsamt sampel blåser inte upp ETA:n', () => {
+    calc.calculateProgressiveETA(fixAt(900, 4), null);
+    jest.advanceTimersByTime(200000);
+    const v = fixAt(400, 0.2);
+    const eta = calc.calculateProgressiveETA(v, null);
+    // Baslinjen = fixets värde på den gamla bufferten [4, 0,2] (snitt 2,1 kn).
+    // Den färska skattningen på bara 0,2 kn (golvet 0,5 kn) är ~4× högre och
+    // dämpas som dramatic_increase mot baslinjen.
+    expect(eta).toBeCloseTo(rawAt(v, 2.1), 1);
+    expect(lines(logger, '[ETA_GAP_BASELINE]')).toHaveLength(1);
+    expect(lines(logger, 'dramatic_increase')).toHaveLength(1);
+    expect(calc._etaHistory.get(MMSI)).toHaveLength(2); // baslinjen + det färska steget
+  });
+});
+
+describe('K6 del 2: outliergrindens fönster följer fartygets kadens', () => {
+  test('ett dramatiskt fall mellan två fix i 70 s kadens fångas utan en andra körning', () => {
+    jest.useFakeTimers({ now: Date.parse('2026-07-15T09:00:00Z') });
+    const logger = makeLogger();
+    const calc = new ProgressiveETACalculator(logger, new BridgeRegistry());
+    try {
+      calc.calculateProgressiveETA(fixAt(2000, 4), null);
+      jest.advanceTimersByTime(70000);
+      calc.calculateProgressiveETA(fixAt(1856, 4), null);
+      jest.advanceTimersByTime(70000);
+      calc.calculateProgressiveETA(fixAt(1712, 4), null);
+      jest.advanceTimersByTime(70000);
+      // Positionsglimt: 1 300 m närmare på 70 s (rå-ETA:n under 40 % av förra).
+      calc.calculateProgressiveETA(fixAt(400, 4), null);
+      expect(lines(logger, 'dramatic_decrease')).toHaveLength(1);
+      expect(lines(logger, '[ETA_FALLBACK] 265039053: Using fallback')).toHaveLength(1);
+    } finally {
+      calc.destroy();
+      jest.useRealTimers();
+    }
+  });
+});
+
+describe('F06: medelfarten får inte ensam lova strax vid inbromsning', () => {
+  let calc; let logger;
+
+  beforeEach(() => {
+    jest.useFakeTimers({ now: Date.parse('2026-09-11T11:56:30Z') });
+    logger = makeLogger();
+    calc = new ProgressiveETACalculator(logger, new BridgeRegistry());
+  });
+
+  afterEach(() => {
+    calc.destroy();
+    jest.useRealTimers();
+  });
+
+  // XENIA-läget i 30 s kadens: 4,8 → 4,7 → 4,5 → 2,5 kn de sista 560 m. På
+  // sista fixet ligger buffertens snitt på 3,9 kn (rå 2,9 min) medan
+  // momentanfarten 2,5 kn ger 4,5 min.
+  function approach(lastExtra = {}) {
+    let eta = null;
+    for (const [m, sog] of [[560, 4.8], [490, 4.7], [420, 4.5]]) {
+      eta = bothPaths(calc, fixAt(m, sog)).snapshot;
+      jest.advanceTimersByTime(30000);
+    }
+    expect(eta).toBeGreaterThanOrEqual(3);
+    return bothPaths(calc, fixAt(350, 2.5, lastExtra)).snapshot;
+  }
+
+  test('ETA:n hålls på 3 min — "om 3", inte "strax"', () => {
+    expect(approach()).toBe(3);
+    expect(lines(logger, '[ETA_DECEL_M9]')).toHaveLength(1);
+  });
+
+  test('imminent-flaggan äger klausulen och får ge under 3', () => {
+    expect(approach({ _isImminentAtTargetBridge: true })).toBeLessThan(3);
+    expect(lines(logger, '[ETA_DECEL_M9]')).toHaveLength(0);
+  });
+
+  test('strax som redan står kvar ur historiken dras inte upp (väntklämman)', () => {
+    // Strax kom inte ur medelfarten i det här fixet: rå-ETA:n på snittet är ≥ 3.
+    const atTarget = {
+      status: 'waiting',
+      targetBridge: 'Stridsbergsbron',
+      lat: BRIDGES.stridsbergsbron.lat - 0.001,
+      lon: BRIDGES.stridsbergsbron.lon,
+    };
+    const prox = { nearestBridge: { id: 'stridsbergsbron', distance: 120 }, nearestDistance: 120 };
+    const first = calc.calculateProgressiveETA({ ...fixAt(0, 2), ...atTarget }, prox);
+    jest.advanceTimersByTime(30000);
+    const second = calc.calculateProgressiveETA({ ...fixAt(0, 0.2), ...atTarget }, prox);
+    expect(second).toBeLessThanOrEqual(first);
+  });
+
+  test('värld 192 (buggjägarens F06): ingen ETA-oscillation med projektets egen validator', () => {
+    const result = runReplay(path.join(FIXTURES, 'e2-f06-xenia-inbromsning-varld192.jsonl'));
+    expect(etaViolations(result)).toEqual([]);
+    const at1158 = result.bridgeTextTransitions.filter((t) => t.iso.slice(11, 16) === '11:58');
+    expect(at1158.some((t) => t.text.includes('beräknad broöppning strax'))).toBe(false);
+  });
+});
+
+describe('F07: spärren jämför en färsk mätning med en mätning, inte med en osedd gissning', () => {
+  const leads = (vessels, vessel, eta) => AISBridgeApp.prototype._leadsEtaGroup.call(
+    { vesselDataService: { getAllVessels: () => vessels } }, vessel, eta,
+  );
+  const boat = (mmsi, targetBridge, etaMinutes) => ({ mmsi, targetBridge, etaMinutes });
+
+  test('ledaren i målbrons grupp avgörs som i brotexten', () => {
+    const jaatten = boat('257919970', 'Klaffbron', 17);
+    const avalon = boat('219009353', 'Klaffbron', 25.3);
+    expect(leads([jaatten, avalon], avalon, 25.3)).toBe(false); // AVALON:s gissning syns inte
+    expect(leads([jaatten, avalon], jaatten, 17)).toBe(true);
+    const sisu = boat('219032725', 'Klaffbron', 13);
+    expect(leads([sisu], sisu, 13)).toBe(true); // SISU/IDUN: ensamma i gruppen
+    expect(leads([boat('1', 'Stridsbergsbron', 2), sisu], sisu, 13)).toBe(true);
+    expect(leads([boat('2', 'Klaffbron', null), sisu], sisu, 13)).toBe(true); // ETA okänd leder inte
+  });
+
+  test('21h-varianten δ −11,52 s och basen ger samma text — ingen sågtand 13 → 19', () => {
+    const variant = runReplay(path.join(FIXTURES, 'e2-f07-avalon-21h-variant.jsonl'));
+    const bas = runReplay(path.join(FIXTURES, 'e2-f07-avalon-21h-bas.jsonl'));
+    expect(etaViolations(variant)).toEqual([]);
+    expect(etaViolations(bas)).toEqual([]);
+    const klaff = (r) => r.bridgeTextTransitions
+      .filter((t) => t.iso >= '2026-07-08T07:11:00' && t.iso < '2026-07-08T07:13:00')
+      .map((t) => t.text.split('; ')[0]);
+    expect(klaff(variant)).toEqual(klaff(bas));
+    expect(klaff(variant)).toContain('Två båtar på väg mot Klaffbron, beräknad broöppning om 18 minuter');
+  });
+});
