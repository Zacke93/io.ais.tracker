+  /**
+   * E2 (F07): leder fartyget sin målbros grupp i brotexten med det här
+   * ETA-värdet? Samma urval som BridgeTextService gör: båtar med samma målbro
+   * som inte står i kö vid en annan bro, utan zombieläge, och ledaren är den
+   * med lägst giltig ETA.
+   * @param {Object} vessel - fartyget
+   * @param {number} eta - fartygets ETA (minuter)
+   * @returns {boolean} sant om värdet är det brotexten visar för gruppen
+   * @private
+   */
+  _leadsEtaGroup(vessel, eta) {
+    const target = vessel && vessel.targetBridge;
+    if (!target || !Number.isFinite(eta)) return false;
+    const inMovingGroup = (v) => {
+      const queue = waitingBridge(v);
+      return !queue || queue === v.targetBridge;
+    };
+    if (!inMovingGroup(vessel)) return false;
+    const all = this.vesselDataService && typeof this.vesselDataService.getAllVessels === 'function'
+      ? this.vesselDataService.getAllVessels() : [];
+    return !all.some((other) => other && String(other.mmsi) !== String(vessel.mmsi)
+      && other.targetBridge === target
+      && Number.isFinite(other.etaMinutes) && other.etaMinutes >= 0
+      && other.etaMinutes < eta
+      && !(Array.isArray(other.passedBridges) && other.passedBridges.includes(other.targetBridge))
+      && inMovingGroup(other));
+  }
+
   /**
