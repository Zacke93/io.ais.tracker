index 0000000..76ce51b
--- /dev/null
+++ b/tests/e2-revision-2026-11-05.test.js
@@ -0,0 +1,368 @@
+'use strict';
+
+jest.mock('homey');
+
+/**
+ * Familj E2, revisionen efter granskningen 2026-11-05.
+ *
+ * 1. Mötande konvoj mot en tyst motpart (BridgeOpeningService, samordnas med
+ *    K/K2). 20260712-25h: ELAIZA och SENTA gick söderut mot Stridsbergsbron och
+ *    absorberades i #33, en norrgående varning för LIFE STYLE som hördes
+ *    senast 15:05:33 och aldrig korsade bron. Täckningen löpte till
+ *    15:27:01,958, och ELAIZA korsade 15:26:06 (gt-passages, line) utan ett
+ *    kort. På e949ae1 räddades hon av slump av SENTA:s egen händelse.
+ * 2. Quick-värld 5 (BRISEN): samma riktning, och U17-klassen — grinden rör den
+ *    inte, och hon är täckt av en avfyrad händelse före sin sanna korsning.
+ * 3. F07: spärren försvarar inte en baslinje som är äldre än Fix G:s mjuka
+ *    gräns mot en LÄGRE färsk mätning (AVALON 21h, "om 18" mot verkliga 4,5).
+ * 4. F06: inbromsningsregeln kräver en verklig inbromsning (kvot ≥ 1,2) och en
+ *    marginal (momentanfartens ETA ≥ 3,5 min) — NORDIC SOLA 19h fick "om 3"
+ *    för en korrekt "strax".
+ * 5. Ledarurvalet följer brotextens lista, och Fix G:s registrering avgörs
+ *    efter snapshot-loopen.
+ * 6. Taket för hållna ökningar (dramatic_increase) — 15 min.
+ */
+
+const path = require('path');
+const { execFileSync } = require('child_process');
+const BridgeRegistry = require('../lib/models/BridgeRegistry');
+const ProgressiveETACalculator = require('../lib/services/ProgressiveETACalculator');
+const BridgeOpeningService = require('../lib/services/BridgeOpeningService');
+const { BRIDGES } = require('../lib/constants');
+const { validateInvariants } = require('./replay-validation/invariants');
+const AISBridgeApp = require('../app');
+
+global.__TEST_MODE__ = true;
+
+const ROOT = path.resolve(__dirname, '..');
+const RUNNER = path.join(ROOT, 'tests/replay-validation/replayRunner.js');
+const FIXTURES = path.join(__dirname, 'fixtures');
+const KLAFF = BRIDGES.klaffbron;
+const M_PER_DEG_LAT = 111320;
+
+function runReplay(jsonlPath) {
+  const env = { ...process.env, NODE_OPTIONS: '', REPLAY_VERBOSE: '' };
+  delete env.REPLAY_MONITORING;
+  const out = execFileSync(process.execPath, [RUNNER, jsonlPath], {
+    cwd: ROOT, encoding: 'utf8', maxBuffer: 64 * 1024 * 1024, env,
+  });
+  return JSON.parse(out.match(/__REPLAY_JSON__(.*?)__END__/s)[1]);
+}
+
+function makeLogger() {
+  return {
+    log: jest.fn(), debug: jest.fn(), error: jest.fn(), warn: jest.fn(),
+  };
+}
+
+const lines = (logger, tag) => logger.debug.mock.calls.map((c) => String(c[0])).filter((s) => s.includes(tag));
+
+describe('Mötande konvoj mot en tyst motpart (25h ELAIZA/SENTA)', () => {
+  const ELAIZA = '265013440';
+  const SENTA = '230198250';
+  const ELAIZA_CROSSING = Date.parse('2026-07-13T15:26:06Z'); // gt-passages, line
+  const SENTA_CROSSING = Date.parse('2026-07-13T15:27:36Z');
+  let result;
+
+  beforeAll(() => {
+    result = runReplay(path.join(FIXTURES, 'e2-25h-elaiza-senta-motande-tyst-vard.jsonl'));
+  });
+
+  test('ELAIZA och SENTA får en söderut-varning för Stridsbergsbron före sina korsningar', () => {
+    const south = result.openingWarnings.filter((w) => w.bridge === 'Stridsbergsbron'
+      && w.direction === 'southbound');
+    const forElaiza = south.find((w) => w.mmsis.includes(ELAIZA) && w.t < ELAIZA_CROSSING);
+    expect(forElaiza).toBeDefined();
+    // Ledtiden minst den utlovade (150 s) före den sanna korsningen.
+    expect(ELAIZA_CROSSING - forElaiza.t).toBeGreaterThanOrEqual(150000);
+    const forSenta = south.find((w) => w.mmsis.includes(SENTA) && w.t < SENTA_CROSSING);
+    expect(forSenta).toBeDefined();
+    expect(SENTA_CROSSING - forSenta.t).toBeGreaterThanOrEqual(150000);
+  });
+
+  test('ingen av dem absorberas i den norrgående händelsen för den tysta LIFE STYLE', () => {
+    const northIds = new Set(result.openingWarnings
+      .filter((w) => w.bridge === 'Stridsbergsbron' && w.direction === 'northbound')
+      .map((w) => w.eventId));
+    const absorbedNorth = result.openingCoverage.filter((c) => c.reason === 'absorbed'
+      && northIds.has(c.eventId) && (c.mmsi === ELAIZA || c.mmsi === SENTA));
+    expect(absorbedNorth).toEqual([]);
+  });
+});
+
+describe('Grinden _meetsOnlySilentOpening', () => {
+  const svc = Object.create(BridgeOpeningService.prototype);
+  const NOW = Date.parse('2026-07-13T15:13:40Z');
+  const SILENT = NOW - 8 * 60000; // LIFE STYLE hördes 15:05:33
+  const event = { id: 'Stridsbergsbron#33', firedAt: NOW - 3 * 60000, firstPassageAt: null };
+  const lead = (extra = {}) => ({
+    mmsi: '211335800',
+    eventId: event.id,
+    warnedAt: event.firedAt,
+    absorbedAt: null,
+    routeDirection: 'north',
+    rawAnchorMs: SILENT,
+    ...extra,
+  });
+  const arm = (extra = {}) => ({
+    mmsi: '265013440',
+    eventId: null,
+    warnedAt: null,
+    absorbedAt: null,
+    routeDirection: 'south',
+    rawAnchorMs: NOW,
+    fireDueMs: NOW + 216000,
+    ...extra,
+  });
+  const meets = (a, e, arms) => svc._meetsOnlySilentOpening(a, e, arms, NOW);
+
+  test('mötande arm och en tyst motpart utan bokförd passage: absorptionen vägras', () => {
+    const a = arm();
+    expect(meets(a, event, [lead(), a])).toBe(true);
+  });
+
+  test('samma riktning rörs inte (en följare bakom en tyst ledare är en konvoj)', () => {
+    const a = arm({ routeDirection: 'north' });
+    expect(meets(a, event, [lead(), a])).toBe(false);
+  });
+
+  test('en färsk motpart bär öppningen', () => {
+    const a = arm();
+    expect(meets(a, event, [lead({ rawAnchorMs: NOW - 60000 }), a])).toBe(false);
+  });
+
+  test('en bokförd passage följer K:s korsningsankare', () => {
+    const a = arm();
+    expect(meets(a, { ...event, firstPassageAt: NOW - 60000 }, [lead(), a])).toBe(false);
+  });
+
+  test('en arm vars egen deadline redan passerat absorberas som förut (DESTINY 14h)', () => {
+    const a = arm({ fireDueMs: NOW - 1000 });
+    expect(meets(a, event, [lead(), a])).toBe(false);
+  });
+
+  test('okänd riktning och en händelse som inte avfyrat ger ingen vägran', () => {
+    const a = arm({ routeDirection: null });
+    expect(meets(a, event, [lead(), a])).toBe(false);
+    const b = arm();
+    expect(meets(b, { ...event, firedAt: null }, [lead(), b])).toBe(false);
+  });
+});
+
+describe('Quick-värld 5 (BRISEN, samma riktning, U17-klassen)', () => {
+  test('BRISEN är täckt av en avfyrad söderut-händelse före sin sanna korsning 08:20:43', () => {
+    const result = runReplay(path.join(FIXTURES, 'e2-quick-varld5-brisen-u17.jsonl'));
+    const crossing = Date.parse('2026-09-19T08:20:43.551Z');
+    const BRISEN = '265549774';
+    const covered = result.openingCoverage.filter((c) => c.mmsi === BRISEN
+      && c.bridge === 'Stridsbergsbron' && c.t < crossing);
+    expect(covered.length).toBeGreaterThan(0);
+    const host = result.openingWarnings.find((w) => w.eventId === covered[0].eventId);
+    expect(host).toBeDefined();
+    expect(host.direction).toBe('southbound');
+    expect(host.t).toBeLessThan(crossing - 150000);
+  });
+});
+
+describe('F07: en inaktuell baslinje försvaras inte mot en lägre färsk mätning', () => {
+  const NOW = Date.parse('2026-07-08T07:07:02.344Z');
+
+  beforeEach(() => {
+    jest.useFakeTimers({ now: NOW });
+  });
+
+  afterEach(() => {
+    jest.useRealTimers();
+  });
+
+  const reconcile = (vessel, fresh) => AISBridgeApp.prototype._reconcilePublishedETA.call({
+    debug: jest.fn(),
+    bridgeRegistry: null,
+    vesselDataService: { getVesselsForBridgeText: () => [vessel] },
+  }, vessel, fresh);
+  const avalon = (ageMs) => ({
+    mmsi: '219009353',
+    targetBridge: 'Klaffbron',
+    _etaPublishTarget: 'Klaffbron',
+    _etaPublishedValue: 30.3,
+    _etaPublishedAtMs: NOW - ageMs,
+  });
+
+  test('AVALON: färska 11,9 mot hennes egen 30,3 från 5,04 min tidigare går igenom', () => {
+    expect(reconcile(avalon(302377), 11.9)).toBeCloseTo(11.9, 5);
+  });
+
+  test('en baslinje inom fem minuter dämpar som förut (SISU 3,5 min, IDUN 3,0 min)', () => {
+    const v = avalon(3.5 * 60000);
+    // maxDelta = max(3, 3,5 + 0,25 · 30,3)
+    expect(reconcile(v, 11.9)).toBeCloseTo(30.3 - (3.5 + 0.25 * 30.3), 5);
+  });
+
+  test('ett hopp UPPÅT mot en inaktuell baslinje dämpas fortfarande (NOCHT 41h)', () => {
+    const v = avalon(6 * 60000);
+    const max = 30.3 + (6 + 0.25 * 30.3);
+    expect(reconcile(v, 60)).toBeCloseTo(max, 5);
+  });
+
+  test('21h-varianten och basen: AVALON visas nära sanningen, ingen sågtand', () => {
+    const variant = runReplay(path.join(FIXTURES, 'e2-f07-avalon-21h-variant.jsonl'));
+    const bas = runReplay(path.join(FIXTURES, 'e2-f07-avalon-21h-bas.jsonl'));
+    for (const r of [variant, bas]) {
+      expect(validateInvariants(r).filter((v) => /ETA-OSCILLATION|ETA-SÅGTAND/.test(v))).toEqual([]);
+    }
+    // Värdet som står 07:11:30, när JÄÄTTEN nollats och AVALON leder. AVALON
+    // korsar 07:16:01 (inferred, 4,5 min). Förut "om 18".
+    const shownAt = (r, iso) => {
+      const before = r.bridgeTextTransitions.filter((t) => t.iso <= iso);
+      const text = before[before.length - 1].text.split('; ')[0];
+      return Number((text.match(/om (?:cirka )?(\d+) minut/) || [])[1]);
+    };
+    const v = shownAt(variant, '2026-07-08T07:11:30.040Z');
+    const b = shownAt(bas, '2026-07-08T07:11:30.040Z');
+    expect(v).toBeLessThanOrEqual(12);
+    expect(b).toBeLessThanOrEqual(12);
+    expect(Math.abs(v - b)).toBeLessThanOrEqual(1);
+  });
+});
+
+describe('Ledarurvalet följer brotexten, och Fix G:s registrering avgörs efter loopen', () => {
+  const boat = (mmsi, etaMinutes, extra = {}) => ({
+    mmsi, targetBridge: 'Klaffbron', etaMinutes, ...extra,
+  });
+
+  test('en filtrerad båt med lägre ETA hindrar inte ledaren som brotexten visar', () => {
+    const shown = boat('1', 9);
+    const filtered = boat('2', 4); // t.ex. BRIDGE_TEXT_FILTER: för långsam
+    const ctx = {
+      vesselDataService: {
+        getVesselsForBridgeText: () => [shown],
+        getAllVessels: () => [shown, filtered],
+      },
+    };
+    expect(AISBridgeApp.prototype._leadsEtaGroup.call(ctx, shown, 9)).toBe(true);
+    // Den filtrerade båten syns inte själv och leder därför inte.
+    expect(AISBridgeApp.prototype._leadsEtaGroup.call(ctx, filtered, 4)).toBe(false);
+  });
+
+  test('en ETA på 0 räknas inte som giltig (isValidETA)', () => {
+    const a = boat('1', 9);
+    const zero = boat('2', 0);
+    const ctx = { vesselDataService: { getVesselsForBridgeText: () => [a, zero], getAllVessels: () => [a, zero] } };
+    expect(AISBridgeApp.prototype._leadsEtaGroup.call(ctx, a, 9)).toBe(true);
+  });
+
+  test('i snapshot-loopen registreras gissningen först efter loopen, mot passets värden', () => {
+    const a = boat('1', 12);
+    const b = boat('2', 14);
+    const ctx = {
+      debug: jest.fn(),
+      vesselDataService: { getVesselsForBridgeText: () => [a, b] },
+      _pendingPublishedNotes: [],
+    };
+    for (const name of ['_notePublishedETA', '_applyPublishedNote', '_flushPublishedNotes', '_leadsEtaGroup']) {
+      ctx[name] = AISBridgeApp.prototype[name].bind(ctx);
+    }
+    ctx._notePublishedETA(b, 11.5, 1000, 'extrapolerad');
+    expect(b._etaPublishedValue).toBeUndefined();
+    // Senare i samma pass sjunker a:s värde — b leder inte efter passet.
+    a.etaMinutes = 10;
+    ctx._flushPublishedNotes();
+    expect(b._etaPublishedValue).toBeUndefined();
+    expect(ctx.debug.mock.calls.some((c) => String(c[0]).includes('[ETA_PUBLISH_UNSEEN]'))).toBe(true);
+    expect(ctx._pendingPublishedNotes).toBeNull();
+  });
+});
+
+describe('F06: inbromsningsregeln kräver en verklig inbromsning och en marginal', () => {
+  let calc; let logger;
+  const MMSI = '258715000';
+
+  beforeEach(() => {
+    jest.useFakeTimers({ now: Date.parse('2026-06-10T06:13:00Z') });
+    logger = makeLogger();
+    calc = new ProgressiveETACalculator(logger, new BridgeRegistry());
+  });
+
+  afterEach(() => {
+    calc.destroy();
+    jest.useRealTimers();
+  });
+
+  const fixAt = (metres, sog) => ({
+    mmsi: MMSI,
+    targetBridge: 'Klaffbron',
+    status: 'approaching',
+    lat: KLAFF.lat - metres / M_PER_DEG_LAT,
+    lon: KLAFF.lon,
+    sog,
+    cog: 20,
+    timestamp: Date.now(),
+    lastPositionUpdate: Date.now(),
+  });
+
+  // Tre fix i 4,6 kn med 10 s mellanrum, sedan det prövade fixet `gapS`
+  // sekunder senare. Förra värdet ligger strax över 3 min (nytt inträde).
+  function approach(lastM, lastSog, offsets, gapS) {
+    for (const off of offsets) {
+      calc.calculateProgressiveETA(fixAt(lastM + off, 4.6), null);
+      jest.advanceTimersByTime(10000);
+    }
+    jest.advanceTimersByTime((gapS - 10) * 1000);
+    return calc.calculateProgressiveETA(fixAt(lastM, lastSog), null);
+  }
+
+  test('NORDIC SOLA 19h: 4,6 → 4,1 kn (kvot 1,08) är ingen inbromsning, och strax står kvar', () => {
+    // 400 m: snittet ger 2,9 min och momentanfarten 3,2 min. Förut "om 3".
+    expect(approach(400, 4.1, [72, 48, 24], 10)).toBeLessThan(3);
+    expect(lines(logger, '[ETA_DECEL_M9]')).toHaveLength(0);
+  });
+
+  test('momentanfartens ETA under 3,5 min är ingen marginal: strax står kvar', () => {
+    // 350 m i 3,3 kn = 3,4 min; kvoten 1,26 räcker, marginalen inte. Förut "om 3".
+    expect(approach(350, 3.3, [119, 95, 71], 30)).toBeLessThan(3);
+    expect(lines(logger, '[ETA_DECEL_M9]')).toHaveLength(0);
+  });
+
+  test('en verklig inbromsning med marginal hålls fortfarande på 3 min (F06)', () => {
+    // 365 m i 3,3 kn = 3,6 min.
+    expect(approach(365, 3.3, [119, 95, 71], 30)).toBe(3);
+    expect(lines(logger, '[ETA_DECEL_M9]')).toHaveLength(1);
+  });
+});
+
+describe('Taket för hållna ökningar (dramatic_increase)', () => {
+  test('en båt som saktar in till 0,6 kn i 30 s kadens fryser inte längre än 15 min', () => {
+    jest.useFakeTimers({ now: Date.parse('2026-07-15T08:00:00Z') });
+    const logger = makeLogger();
+    const calc = new ProgressiveETACalculator(logger, new BridgeRegistry());
+    try {
+      let m = 3000;
+      const values = [];
+      for (let i = 0; i < 60; i++) {
+        const sog = i < 8 ? 4 : 0.6;
+        m -= sog * (1852 / 3600) * 30;
+        const v = {
+          mmsi: '265000002',
+          targetBridge: 'Klaffbron',
+          status: 'en-route',
+          lat: KLAFF.lat - m / M_PER_DEG_LAT,
+          lon: KLAFF.lon,
+          sog,
+          cog: 20,
+          timestamp: Date.now(),
+          lastPositionUpdate: Date.now(),
+        };
+        values.push(calc.calculateProgressiveETA(v, null));
+        jest.advanceTimersByTime(30000);
+      }
+      const held = values[10];
+      // Inom taket hålls ökningen (F74), efter taket växer ETA:n mot verkligheten.
+      expect(values[20]).toBeCloseTo(held, 5);
+      expect(Math.max(...values.slice(45))).toBeGreaterThan(held + 2);
+      expect(lines(logger, '[ETA_INCREASE_BOUND]').length).toBeGreaterThan(0);
+    } finally {
+      calc.destroy();
+      jest.useRealTimers();
+    }
+  });
+});
