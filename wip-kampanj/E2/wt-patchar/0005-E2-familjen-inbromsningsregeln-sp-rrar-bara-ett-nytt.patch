 lib/services/ProgressiveETACalculator.js      | 10 ++++++++++
 tests/e2-eta-etapp-2026-11-04.test.js         | 12 +++++++++++
 .../e2-f06-runa-usvang-varld286.jsonl         | 20 +++++++++++++++++++
 3 files changed, 42 insertions(+)
 create mode 100644 tests/fixtures/e2-f06-runa-usvang-varld286.jsonl

diff --git a/lib/services/ProgressiveETACalculator.js b/lib/services/ProgressiveETACalculator.js
index fc8fcd4..dc759a2 100644
--- a/lib/services/ProgressiveETACalculator.js
+++ b/lib/services/ProgressiveETACalculator.js
@@ -1660,7 +1660,17 @@ class ProgressiveETACalculator {
       adjustedETA = STRAX_THRESHOLD_MINUTES;
     }
 
+    // E2 (F06, M9-principen vid inbromsning): buffertens medelfart ligger
+    // efter när båten bromsar in. Lovar medelfarten ensam strax medan
+    // momentanfarten ger minst 3 min, hålls ETA:n på 3 min (XENIA, värld 192:
+    // strax → om 4 → strax). Regeln spärrar bara ett NYTT inträde i strax:
+    // stod förra värdet redan under 3 min är löftet redan givet, och att lyfta
+    // det till 3 gav i stället strax → om 3 → strax (RUNA, U-sväng i
+    // buggjägarens quick-värld 286).
+    const straxAlreadyGiven = history.length > 0
+      && history[history.length - 1].processedETA < STRAX_THRESHOLD_MINUTES;
     if (decelInstantETA !== null
+        && !straxAlreadyGiven
         && decelRawETA < STRAX_THRESHOLD_MINUTES
         && decelInstantETA >= STRAX_THRESHOLD_MINUTES
         && vessel._isImminentAtTargetBridge !== true
diff --git a/tests/e2-eta-etapp-2026-11-04.test.js b/tests/e2-eta-etapp-2026-11-04.test.js
index d3c07b1..402a020 100644
--- a/tests/e2-eta-etapp-2026-11-04.test.js
+++ b/tests/e2-eta-etapp-2026-11-04.test.js
@@ -353,6 +353,18 @@ describe('F06: medelfarten får inte ensam lova strax vid inbromsning', () => {
     const at1158 = result.bridgeTextTransitions.filter((t) => t.iso.slice(11, 16) === '11:58');
     expect(at1158.some((t) => t.text.includes('beräknad broöppning strax'))).toBe(false);
   });
+
+  test('värld 286 (U-sväng, quick): en redan given strax lyfts inte till "om 3"', () => {
+    // RUNA bromsar från 6,3 till 2,5 kn i U-svängen 307 m före Klaffbron.
+    // Förra värdet stod redan under 3 min ("strax"); att hålla på 3 gav
+    // strax → om 3 → strax. Regeln spärrar bara ett nytt inträde i strax.
+    const result = runReplay(path.join(FIXTURES, 'e2-f06-runa-usvang-varld286.jsonl'));
+    expect(etaViolations(result)).toEqual([]);
+    const texts = result.bridgeTextTransitions
+      .filter((x) => x.iso >= '2026-07-11T15:04' && x.iso < '2026-07-11T15:07')
+      .map((x) => x.text);
+    expect(texts).toEqual(['En båt på väg mot Klaffbron, beräknad broöppning strax']);
+  });
 });
 
 describe('F07: spärren jämför en färsk mätning med en mätning, inte med en osedd gissning', () => {
